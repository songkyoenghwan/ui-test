{
	"name": "map",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun run fm && vite build -c vite.config.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"doctor": "svelte-doctor check",
		"dev": "vite --host --port 5184",
		"mock": "json-server --watch ./static/json/db.json --port 4000",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"fm": "prettier --write . && oxfmt",
		"format:prettier": "prettier --write .",
		"lang": "bun x @inlang/cli machine translate --project ./project.inlang",
		"lang:val": "bun x @inlang/cli validate --project ./project.inlang",
		"lint": "oxlint .",
		"pb": "./pocketbase serve",
		"prepare": "svelte-kit sync || echo ''",
		"preview": "vite preview -c vite.config.mjs",
		"sp:fix": "syncpack fix",
		"sp:format": "syncpack format",
		"sp:lint": "syncpack lint --dependency-types prod,dev",
		"wc": "bun -b run vite build -c vite.config.sv.mjs"
	},
	"dependencies": {
		"@ariefsn/svelte-use": "^1.1.0",
		"@dnd-kit/helpers": "^0.5.0",
		"@dnd-kit/svelte": "^0.5.0",
		"@master/css": "^1.37.8",
		"@uinstinct/svelte-wheel-picker": "^0.1.33",
		"alpinejs": "^3.15.12",
		"embla-carousel": "^8.6.0",
		"embla-carousel-svelte": "^8.6.0",
		"es-toolkit": "^1.47.1",
		"flowbite": "^4.0.2",
		"keen-slider": "^6.8.6",
		"lit": "^3.3.2",
		"nanostores": "^1.3.0",
		"pickerjs": "^1.2.1",
		"sortablejs": "^1.15.7",
		"svelte": "^5.55.5",
		"svelte-awesome-color-picker": "^4.1.3",
		"svelte-draggable-plus": "^0.1.1",
		"svelty-picker": "^6.1.6",
		"unsortable": "^0.1.9",
		"uuid": "^14.0.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@floating-ui/utils": "^0.2.11",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@inlang/paraglide-js": "^2.20.0",
		"@lucide/svelte": "^1.21.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.5",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/enhanced-img": "^0.10.4",
		"@sveltejs/kit": "^2.66.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.1",
		"@tsconfig/svelte": "^5.0.8",
		"@types/alpinejs": "^3.13.11",
		"@types/bun": "^1.3.14",
		"@types/dropzone": "^5.7.9",
		"@types/node": "^25.9.3",
		"@types/sortablejs": "^1.15.9",
		"concurrently": "^9.2.3",
		"css-property-sort-order-smacss": "^3.0.0",
		"flatpickr": "^4.6.13",
		"flowbite-svelte": "^1.33.1",
		"flowbite-svelte-icons": "^3.1.0",
		"lit": "^3.3.3",
		"oxc": "^1.0.1",
		"oxfmt": "^0.48.0",
		"oxlint": "^1.70.0",
		"postgres": "^3.4.9",
		"prettier": "^3.8.4",
		"prettier-plugin-css-order": "^2.2.0",
		"prettier-plugin-organize-attributes": "^1.0.0",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"sass": "^1.101.0",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	}
}
