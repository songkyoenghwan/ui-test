---
import Header from '@/layouts/Header.astro';
import Lnb from '@/layouts/Lnb.astro';
import ScriptInline from '@/layouts/ScriptInline.astro';
import '@/styles/index.css';

interface Props {
	Title?: string;
}
const { Title: title } = Astro.props;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="shortcut icon" href="/favicon.svg" type="image/x-icon" />
		<meta name="view-transition" content="same-origin" />
		<meta name="generator" content={Astro.generator} />
		<title>{pathname} |</title>
		<script
			is:inline
			src="https://apis.openapi.sk.com/tmap/vectorjs?version=1&appKey=3ashZLfRgx7lSmm7BRP1C4ZcSq5RuPq45hA16RXZ"
		></script>
	</head>
	<body x-data>
		<section class="grid h-dvh grid-cols-[var(--lnb-width)_1fr] grid-rows-[var(--header-height)_1fr]">
			<Lnb />

			<Header />

			<main class="main-container" id="main-container">
				<slot />
			</main>
		</section>

		<script>
			import '@/src/index.ts';
		</script>

		<script defer src="/store/layout-store.js"></script>
	</body>
</html>
