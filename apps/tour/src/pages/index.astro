---
import LayoutBasic from '@/layouts/LayoutBasic.astro';
import '@/styles/index.css';

type PageStatus = '완료' | '수정' | '삭제' | '신규' | '확인 필요';

interface PageLink {
	text: string;
	url: string;
	status?: PageStatus;
	description?: string;
}

interface PageSection {
	title: string;
	links: PageLink[];
}

const sections: PageSection[] = [
	{
		title: '지도',
		links: [
			{
				text: '지도',
				url: '/CMS-MAP-001/',
			},
		],
	},
	{
		title: '대상지',
		links: [
			{
				text: '대상지 관리(List)',
				url: '/tour-destination',
			},
			{
				text: '대상지 상세',
				url: '/tour-destination/detail/1',
			},
			{
				text: '대상지 수정',
				url: '/tour-destination/edit/1',
			},
			{
				text: '대상지 등록',
				url: '/tour-destination/reg/112738192387',
			},
		],
	},
	{
		title: '시설',
		links: [
			{
				text: '위치',
				url: '/poi/map',
				description: '모달: 등록된 시설 매칭',
			},
			{
				text: '시설(List)',
				url: '/poi/facility',
			},
			{
				text: '카테고리',
				url: '/poi/category',
				description: '모달: 하위 카테고리(등록/수정)',
			},
		],
	},
	{
		title: '온보딩',
		links: [
			{
				text: '온보딩',
				url: '/onboarding/popup',
			},
			{
				text: '기초 설문',
				url: '/onboarding/survey',
			},
		],
	},
];

const statusClasses: Record<PageStatus, string> = {
	완료: 'text-[#222]',
	수정: 'text-red-600',
	삭제: 'text-gray-300 line-through',
	신규: 'text-2070fb',
	'확인 필요': 'text-green-600',
};

const getStatusClass = (status?: PageStatus) => (status ? statusClasses[status] : 'text-gray-600');
---

<LayoutBasic>
	<main class="p-2" aria-labelledby="page-title">
		<h1 id="page-title" class="text-2070fb m-2 pb-2 text-2xl font-bold">관광솔루션</h1>

		{
			sections.map((section) => (
				<section class="p-2" aria-labelledby={`section-${section.title}`}>
					<h2 id={`section-${section.title}`} class="text-2d3648 m-2 text-xl font-bold">
						{section.title}
					</h2>

					<ul class="grid gap-1">
						{section.links.map((link, linkIndex) => (
							<li
								class={`border-b border-gray-300 transition-shadow hover:shadow-md ${getStatusClass(link.status)}`}
							>
								<a
									href={link.url}
									target="_blank"
									rel="noopener noreferrer"
									class="group flex min-h-11 items-center justify-between gap-3 rounded-sm p-2 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
								>
									<span class="font-medium">
										{linkIndex + 1}. {link.text}
										<span class="ml-1 text-xs font-normal text-gray-500">{link.url}</span>
									</span>

									{link.description && (
										<span class="shrink-0 rounded bg-gray-100 px-2 py-0.5 text-xs text-gray-600 group-hover:bg-white">
											{link.description}
										</span>
									)}
								</a>
							</li>
						))}
					</ul>
				</section>
			))
		}
	</main>
</LayoutBasic>
