---
import LayoutBasic from '@/layouts/LayoutBasic.astro';
import PopupPreview from '@/pages/onboarding/popup/PopupPreview.astro';
import PopupSide from '@/pages/onboarding/popup/PopupSide.astro';
---

<LayoutBasic>
	<div
		data-scroll="none"
		class="grid h-full w-[calc(100dvw-100px)] flex-1 grid-cols-[minmax(240px,320px)_minmax(360px,1fr)_minmax(240px,480px)] grid-rows-[28px_1fr] gap-5 py-5 pl-5"
	>
		<PopupSide />

		<header class="order-2 col-span-2 flex items-center justify-between">
			<div class="flex items-center gap-2.5">
				<ui-tit size="lg" :tit="view === 'edit' ? '온보딩 수정' : '온보딩 등록'"></ui-tit>

				<text-badge variant="primary" txt="배포 중"></text-badge>
				<text-badge variant="error" txt="배포 전"></text-badge>
			</div>

			<div class="grid grid-cols-[150px] gap-2 has-[[icon-name=trash]]:grid-cols-[60px_150px]">
				<template x-if="view === 'edit'">
					<ui-btn
						variant="icon"
						icon-name="trash"
						icon-cls="size-4 stroke-slate-400"
						class="rounded-sm border border-slate-200 bg-white"
						txt="삭제"></ui-btn>
				</template>
				<ui-btn variant="primary" cls="font-bold" txt="저장"></ui-btn>
			</div>
		</header>

		<ul class="order-4 inline-flex h-full flex-1 flex-col gap-3 overflow-x-clip overflow-y-auto p-1">
			<li class="shadow-1xs grid gap-5 rounded-lg bg-white px-5 py-4">
				<section class="col-span-2 grid grid-cols-[90px_1fr] gap-4">
					<ui-tit
						tag="h4"
						tit="제목"
						tip="15자 이내 권장"
						tooltip="언어에 따라 표현 길이가 달라질 수 있으므로 <br />번역 내용을 확인해주세요. <strong>(최대 50자)</strong>"
					></ui-tit>
					<lang-translate data-max-length="50"> </lang-translate>
				</section>
			</li>
			<li class="shadow-1xs grid gap-5 rounded-lg bg-white px-5 py-4">
				<section class="col-span-2 grid grid-cols-[90px_1fr] gap-4">
					<ui-tit
						tag="h4"
						tit="세부 내용"
						req
						tip="40자 이내 권장"
						tooltip="언어에 따라 표현 길이가 달라질 수 있으므로 <br />번역 내용을 확인해주세요. <strong>(최대 100자)</strong>"
					></ui-tit>
					<lang-translate data-max-length="15"> </lang-translate>
				</section>
			</li>
			<li class="shadow-1xs grid gap-5 rounded-lg bg-white px-5 py-4">
				<section class="grid gap-4">
					<ui-tit tag="h4" tit="메인 이미지" sub="온보딩 화면에 메인으로 보이는 이미지입니다. e.g. 서비스 목업"
					></ui-tit>
					<dl class="grid grid-cols-[60px_1fr] items-center gap-2">
						<dt>
							<ui-tit tag="h5" tit="기본"></ui-tit>
						</dt>
						<dd>
							<thumbnail-upload cls="w-full h-15" size="onboarding"></thumbnail-upload>
						</dd>
						<dt>
							<ui-tit
								class="flex items-center gap-1"
								tag="h5"
								tit="다국어"
								tooltip="사용자 언어 설정이 한국어가 아닌 경우 다국어 이미지가 지도에 표시됩니다.<br />다국어 이미지가 등록되지 않은 경우에는 국문 이미지로 대체됩니다."
							></ui-tit>
							<ui-txt size="xs" txt="선택"></ui-txt>
						</dt>
						<dd>
							<thumbnail-upload cls="w-full h-15" size="onboarding"></thumbnail-upload>
						</dd>
					</dl>
				</section>
			</li>
			<li class="shadow-1xs grid gap-5 rounded-lg bg-white px-5 py-4">
				<section class="grid gap-4">
					<ui-tit tag="h4" tit="서브 이미지" sub="메인 이미지보다 더 작게 보이는 이미지입니다. e.g. 기업·기관 로고"
					></ui-tit>
					<dl class="grid grid-cols-[60px_1fr] items-center gap-2">
						<dt>
							<ui-tit tag="h5" tit="기본"></ui-tit>
						</dt>
						<dd>
							<thumbnail-upload cls="w-full h-15" size="onboarding"></thumbnail-upload>
						</dd>
						<dt>
							<ui-tit
								class="flex items-center gap-1"
								tag="h5"
								tit="다국어"
								tooltip="사용자 언어 설정이 한국어가 아닌 경우 다국어 이미지가 지도에 표시됩니다.<br />다국어 이미지가 등록되지 않은 경우에는 국문 이미지로 대체됩니다."
							></ui-tit>
							<ui-txt size="xs" txt="선택"></ui-txt>
						</dt>
						<dd>
							<thumbnail-upload cls="w-full h-15" size="onboarding"></thumbnail-upload>
						</dd>
					</dl>
				</section>
			</li>
		</ul>

		<PopupPreview />
	</div>
</LayoutBasic>

<div class="fixed bottom-5 left-25 z-5 inline-flex gap-2">
	<button @click.prevent="toast.success('배포 해제되었습니다.')">토스트</button>
	<button @click.prevent="toast.success('배포되었습니다.')">토스트</button>
	<button @click.prevent="toast.success('임시 저장되었습니다.')">토스트</button>
	<button @click.prevent="toast.success('삭제되었습니다.')">토스트</button>
	/
	<button @click.prevent="toast.error('다국어 이미지 등록 후 다시 시도해 주세요')">토스트</button>
	<button @click.prevent="toast.error('배포 해제할 온보딩을 선택해 주세요.')">토스트</button>
	<button @click.prevent="toast.error('배포할 설문을 선택해 주세요.')">토스트</button>
	/
	<button @click.prevent="$store.alert.open('alert1')">알림1</button>
	<button @click.prevent="$store.alert.open('alert2')">알림2</button>
	<button @click.prevent="$store.alert.open('alert3')">알림3</button>
	<button @click.prevent="$store.alert.open('alert4')">알림4</button>
	<button @click.prevent="$store.alert.open('alert5')">알림5</button>
</div>

<alert-popup
	id="alert1"
	open="close"
	txt="배포 해제 시 사용자 지도에 즉시 비노출됩니다. <br />n건의 온보딩 화면을 배포 해제하시겠습니까?"
	cancel="취소"
	@alert-cancel="alert()"
	@alert-confirm="alert()"></alert-popup>
<alert-popup
	id="alert2"
	open="close"
	txt="배포 시 사용자 지도에 즉시 반영됩니다.<br />n건의 온보딩 화면을 배포하시겠습니까?"
	cancel="취소"
	@alert-cancel="alert()"
	@alert-confirm="alert()"></alert-popup>
<alert-popup
	id="alert3"
	open="close"
	txt="최대 10개까지 배포 가능합니다."
	cancel="취소"
	@alert-cancel="alert()"
	@alert-confirm="alert()"></alert-popup>
<alert-popup
	id="alert4"
	open="close"
	txt="$제목$ 온보딩 화면을 삭제하시겠습니까?"
	cancel="취소"
	@alert-cancel="alert()"
	@alert-confirm="alert()"></alert-popup>
<alert-popup
	id="alert5"
	open="close"
	txt="배포 시 사용자 지도에 즉시 반영됩니다. <br />온보딩 화면을 배포하시겠습니까?"
	cancel="취소"
	@alert-cancel="alert()"
	@alert-confirm="alert()"></alert-popup>

<script defer>
	document.addEventListener('alpine:init', () => {
		const Alpine = window.Alpine;
		if (Alpine.store('data')) return;

		Alpine.store('data', {
			error: null,
			itemId: 1,
			items: Array.from({ length: 50 }, (_, idx) => ({
				id: idx + 1,
				tourDestinationId: 1,
				title: {
					ko: `온보딩 ${idx + 1}`,
					en: 'Onboarding 1',
				},
				description: {
					ko: '설명',
					en: 'Description',
				},
				sortingNumber: null,
				deploymentStatus: idx < 40 ? 'DRAFT' : 'DEPLOYING',
				createdAt: '2026-07-11T12:23:15.300Z',
				updatedAt: null,
				onboardingFiles: [
					{
						id: 8,
						fileOriginalName: '',
						fileUrl: '',
						fileUploadPath: '',
						fileUploadName: '',
						fileSize: 1,
						fileMimeType: '',
						fileType: 'MAIN',
					},
				],
			})),
			data: {},

			get deploymentItems() {
				return (this.items ?? []).filter((item) => item?.deploymentStatus === 'DEPLOYING').length;
			},

			currentItem(_id = '') {
				this.itemId = _id;
			},

			deploymentHandler(id = 1) {
				if (!id) return;
				this.data = this.items.find((v) => v.id === Number(id)) ?? {};
			},

			moveItemToStatus(id, status) {
				const item = this.items.find((v) => String(v.id) === String(id));
				if (!item) return;

				item.deploymentStatus = status;
			},

			syncItemsOrder(rootEl = document) {
				const deployingIds = [...rootEl.querySelectorAll('[data-status="DEPLOYING"] [data-id]')].map((el) =>
					String(el.dataset.id),
				);

				const draftIds = [...rootEl.querySelectorAll('[data-status="DRAFT"] [data-id]')].map((el) =>
					String(el.dataset.id),
				);

				const orderedIds = [...deployingIds, ...draftIds];
				const orderMap = new Map(orderedIds.map((id, idx) => [id, idx + 1]));

				this.items.forEach((item) => {
					const id = String(item.id);

					if (deployingIds.includes(id)) {
						item.deploymentStatus = 'DEPLOYING';
					} else if (draftIds.includes(id)) {
						item.deploymentStatus = 'DRAFT';
					}

					item.sortingNumber = orderMap.get(id) ?? null;
				});

				this.items.sort((a, b) => {
					const aOrder = orderMap.get(String(a.id)) ?? Number.MAX_SAFE_INTEGER;
					const bOrder = orderMap.get(String(b.id)) ?? Number.MAX_SAFE_INTEGER;
					return aOrder - bOrder;
				});

				if (this.itemId) {
					this.data = this.items.find((v) => String(v.id) === String(this.itemId)) ?? {};
				}
			},

			init() {},
		});
	});
</script>
