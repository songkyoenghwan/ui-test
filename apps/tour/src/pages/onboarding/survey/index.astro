---
import LayoutBasic from '@/layouts/LayoutBasic.astro';
import SurveySide from '@/pages/onboarding/survey/SurveySide.astro';
---

<LayoutBasic>
	<div
		data-scroll="none"
		class="grid h-full w-[calc(100dvw-100px)] flex-1 grid-cols-[320px_1fr] grid-rows-[minmax(28px,auto)_1fr] gap-x-5 gap-y-3 overflow-x-auto py-5 pl-5"
	>
		<SurveySide />

		<header class="order-2 flex flex-col gap-3">
			<text-badge
				class="col-span-2"
				variant="border-error"
				del="del"
				cls="w-full text-xs leading-none"
				icon="info-circle-outline"
				txt="응답 데이터가 있을 경우 일부 수정이 제한되며, 내용 수정 시 기존 응답과 기초 정보 통계 해석에 혼선이 생길 수 있으니 신중하게 변경해 주세요."
			></text-badge>

			<div class="flex items-center justify-between">
				<div class="flex items-center gap-2.5">
					<ui-tit size="lg" :tit="view === 'edit' ? '기초 설문 수정' : '기초 설문 등록'"></ui-tit>

					<text-badge variant="primary" txt="배포 중"></text-badge>
					<text-badge variant="pastel-error" txt="배포 전"></text-badge>
					<text-badge variant="bg-slate" txt="배포 종료"></text-badge>

					<div class="flex flex-wrap items-center gap-2">
						<ui-txt size="xs" txt="배포"></ui-txt>
						<text-date
							class="text-sm text-slate-500"
							data-time-view="time"
							x-bind:dateTime="$store.data?.items?.[0]?.deployedAt"></text-date>
					</div>
				</div>

				<div class="grid grid-cols-[150px] gap-2 has-[[icon-name=trash]]:grid-cols-[60px_150px]">
					<template x-if="view === 'edit'">
						<ui-btn
							variant="icon"
							icon-name="trash"
							icon-cls="size-4 stroke-slate-400"
							class="rounded-sm border border-slate-200 bg-white"
							txt="삭제"></ui-btn>
					</template>
					<ui-btn variant="primary" cls="font-bold" txt="저장"></ui-btn>
				</div>
			</div>
		</header>

		<ul class="order-3 inline-flex flex-1 flex-col gap-3 overflow-x-clip overflow-y-auto p-1">
			<li class="shadow-1xs grid gap-5 rounded-lg bg-white px-5 py-4">
				<section class="col-span-2 grid grid-cols-[90px_1fr] gap-4">
					<ui-tit
						tag="h4"
						tit="설문명"
						tip="10자 이내 권장"
						tooltip="언어에 따라 표현 길이가 달라질 수 있으므로 <br />번역 내용을 확인해주세요. <strong>(최대 50자)</strong>"
					></ui-tit>
					<lang-translate data-max-length="50"> </lang-translate>
				</section>
			</li>

			<li class="grid grid-cols-2 gap-5">
				<div class="shadow-1xs grid gap-5 rounded-lg bg-white px-5 py-4">
					<section class="grid grid-cols-[1fr_164px] items-center gap-5">
						<div>
							<ui-tit class="flex items-center gap-2" tag="h4" tit="설문 유형"></ui-tit>
						</div>
						<div x-data="{ isMulti: false }">
							<label for="toggleAiRecommended" class="flex items-center gap-1 select-none">
								<input
									type="checkbox"
									id="toggleAiRecommended"
									name="toggleAiRecommended"
									class="peer sr-only"
									x-model="isMulti"
								/>

								<text-badge
									cls="min-w-20"
									size="md"
									:variant="!isMulti ? 'bg-primary' : 'border-slate-300'"
									txt="단일 선택"></text-badge>

								<text-badge
									cls="min-w-20"
									size="md"
									:variant="isMulti ? 'bg-primary' : 'border-slate-300'"
									txt="다중 선택"></text-badge>
							</label>
						</div>
					</section>
				</div>

				<div class="shadow-1xs grid gap-5 rounded-lg bg-white px-5 py-4">
					<section class="grid grid-cols-[1fr_33px] items-center gap-5">
						<div>
							<ui-tit class="flex items-center gap-2" tag="h4" tit="AI 추천 활용"></ui-tit>
							<ui-txt size="xs" txt="응답이 AI 추천 기반 데이터로 활용됩니다. 의미가 명확한 항목으로 구성해 주세요."
							></ui-txt>
						</div>
						<ui-checkbox variant="toggle"></ui-checkbox>
					</section>
				</div>
			</li>

			<li class="shadow-1xs grid gap-4 rounded-lg bg-white px-5 py-4">
				<div>
					<ui-tit class="flex gap-2" tag="h4" tit="답변 항목" sub="* 최소 2개~최대 8개까지 등록 가능합니다"></ui-tit>
					<hover-tooltip
						btn="6자 이내 권장"
						txt="언어에 따라 표현 길이가 달라질 수 있으므로 <br />번역 내용을 확인해주세요. (최대 15자)"
						class="flex"></hover-tooltip>
				</div>

				<ul class="divide-y divide-slate-200" x-sort x-sort:config="{ animation: 150, handle: '[data-drag-handle]', }">
					<template x-for="(option, index) in ($store.data?.items?.[0]?.options ?? [])" :key="option?.id ?? index">
						<li class="grid grid-cols-[1fr_86px_20px] items-center gap-5 py-3 pr-5">
							<div class="grid grid-cols-[50px_1fr] gap-1.5">
								<button
									type="button"
									class="grid h-full grid-cols-[16px] items-center gap-2 py-3 pl-5 select-none"
									aria-label="Drag handle"
									data-drag-handle
								>
									<icon-list data-name="dnd" class="group-aria-current/dnd:fill-cms-3 size-4 fill-slate-300"
									></icon-list>
								</button>

								<lang-translate :data-max-length="15" :ko="option?.title?.ko"></lang-translate>
							</div>

							<div class="flex flex-wrap items-center gap-3">
								<ui-txt size="sm" txt="활성화"></ui-txt>
								<ui-checkbox variant="toggle" checked=""></ui-checkbox>
							</div>

							<ui-btn
								size="sm"
								variant="icon"
								icon-name="btn-del"
								icon-cls="size-4 fill-error"
								class="border-error rounded-sm border bg-white"
								txt="삭제"></ui-btn>
						</li>
					</template>
				</ul>
			</li>
		</ul>
	</div>
</LayoutBasic>

<div class="fixed bottom-5 left-25 z-5 inline-flex gap-2">
	<button @click.prevent="toast.success('배포 해제되었습니다.')">토스트</button>
	<button @click.prevent="toast.success('배포되었습니다.')">토스트</button>
	<button @click.prevent="toast.success('임시 저장되었습니다.')">토스트</button>
	<button @click.prevent="toast.success('삭제되었습니다.')">토스트</button>
	/
	<button @click.prevent="toast.error('다국어 이미지 등록 후 다시 시도해 주세요')">토스트</button>
	<button @click.prevent="toast.error('배포 해제할 기초 설문을 선택해 주세요.')">토스트</button>
	<button @click.prevent="toast.error('배포할 설문을 선택해 주세요.')">토스트</button>
	/
	<button @click.prevent="$store.alert.open('alert1')">알림1</button>
	<button @click.prevent="$store.alert.open('alert2')">알림2</button>
	<button @click.prevent="$store.alert.open('alert3')">알림3</button>
	<button @click.prevent="$store.alert.open('alert4')">알림4</button>
	<button @click.prevent="$store.alert.open('alert5')">알림5</button>
</div>

<alert-popup
	id="alert1"
	open="close"
	txt="배포 해제 시 사용자 지도에 즉시 비노출됩니다. <br />n건의 기초 설문 화면을 배포 해제하시겠습니까?"
	cancel="취소"
	@alert-cancel="alert()"
	@alert-confirm="alert()"></alert-popup>
<alert-popup
	id="alert2"
	open="close"
	txt="배포 시 사용자 지도에 즉시 반영됩니다.<br />n건의 기초 설문 화면을 배포하시겠습니까?"
	cancel="취소"
	@alert-cancel="alert()"
	@alert-confirm="alert()"></alert-popup>
<alert-popup
	id="alert3"
	open="close"
	txt="최대 10개까지 배포 가능합니다."
	cancel="취소"
	@alert-cancel="alert()"
	@alert-confirm="alert()"></alert-popup>
<alert-popup
	id="alert4"
	open="close"
	txt="$제목$ 기초 설문 화면을 삭제하시겠습니까?"
	cancel="취소"
	@alert-cancel="alert()"
	@alert-confirm="alert()"></alert-popup>
<alert-popup
	id="alert5"
	open="close"
	txt="배포 시 사용자 지도에 즉시 반영됩니다. <br />기초 설문 화면을 배포하시겠습니까?"
	cancel="취소"
	@alert-cancel="alert()"
	@alert-confirm="alert()"></alert-popup>

<script defer>
	document.addEventListener('alpine:init', () => {
		const Alpine = window.Alpine;
		if (Alpine.store('data')) return;

		Alpine.store('data', {
			loading: false,
			error: null,
			itemId: 1,
			items: Array.from({ length: 50 }, (_, idx) => ({
				id: idx + 1,
				tourDestinationId: 1,
				title: `연령대${idx + 1}`,
				questionType: idx < 1 ? 'SINGLE' : 'MULTI',
				isAiRecommendationEnabled: true,
				deploymentStatus: idx < 5 ? 'ENDED' : idx < 10 ? 'DEPLOYING' : 'DRAFT', // ENDED || DEPLOYING || DRAFT
				deployedAt: '2026-06-12T16:17:36.936Z',
				deploymentEndedAt: '2026-06-15T12:09:26.516Z',
				createdAt: '2026-06-12T12:11:17.011Z',
				options: [
					{
						id: 1,
						optionItem: {
							ko: '10대',
							en: '10',
							ja: '',
							zh: '',
							vi: '',
							th: '',
						},
						sortingNumber: 1,
						isActive: true,
					},
					{
						id: 2,
						optionItem: {
							ko: '20대',
							en: '20',
							ja: '',
							zh: '',
							vi: '',
							th: '',
						},
						sortingNumber: 2,
						isActive: true,
					},
					{
						id: 3,
						optionItem: {
							ko: '30대',
							en: '30',
							ja: '',
							zh: '',
							vi: '',
							th: '',
						},
						sortingNumber: null,
						isActive: true,
					},
					{
						id: 4,
						optionItem: {
							ko: '40대',
							en: '40',
							ja: '',
							zh: '',
							vi: '',
							th: '',
						},
						sortingNumber: null,
						isActive: true,
					},
				],
			})),
			data: {},

			get deploymentItems() {
				return (this.items ?? []).filter((item) => item?.deploymentStatus === 'DEPLOYING').length;
			},

			currentItem(_id = '') {
				this.itemId = _id;

				return;
			},

			deploymentHandler(id = 1) {
				if (!id) return;
				this.data = this.items.find((v) => v.id === Number(id)) ?? {};
			},

			moveItemToStatus(id, status) {
				const item = this.items.find((v) => String(v.id) === String(id));
				if (!item) return;

				item.deploymentStatus = status;
			},

			syncItemsOrder(rootEl = document) {
				const deployingIds = [...rootEl.querySelectorAll('[data-status="DEPLOYING"] [data-id]')].map((el) =>
					String(el.dataset.id),
				);

				const draftIds = [...rootEl.querySelectorAll('[data-status="DRAFT"] [data-id]')].map((el) =>
					String(el.dataset.id),
				);

				const orderedIds = [...deployingIds, ...draftIds];
				const orderMap = new Map(orderedIds.map((id, idx) => [id, idx + 1]));

				this.items.forEach((item) => {
					const id = String(item.id);

					if (deployingIds.includes(id)) {
						item.deploymentStatus = 'DEPLOYING';
					} else if (draftIds.includes(id)) {
						item.deploymentStatus = 'DRAFT';
					}

					item.sortingNumber = orderMap.get(id) ?? null;
				});

				this.items.sort((a, b) => {
					const aOrder = orderMap.get(String(a.id)) ?? Number.MAX_SAFE_INTEGER;
					const bOrder = orderMap.get(String(b.id)) ?? Number.MAX_SAFE_INTEGER;
					return aOrder - bOrder;
				});

				if (this.itemId) {
					this.data = this.items.find((v) => String(v.id) === String(this.itemId)) ?? {};
				}
			},

			init() {},
		});
	});
</script>
