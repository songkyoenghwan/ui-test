---
import LayoutBasic from '@/layouts/LayoutBasic.astro';
import SurveySide from '@/pages/onboarding/survey/SurveySide.astro';
---

<LayoutBasic>
	<div
		class="grid h-full w-[calc(100dvw-100px)] flex-1 grid-cols-[320px_1fr] grid-rows-[28px_1fr] gap-5 overflow-x-auto py-5 pl-5"
	>
		<SurveySide />

		<header class="order-2 flex items-center justify-between">
			<div class="flex items-center gap-2.5">
				<ui-tit size="lg" :tit="$store.data.view === 'edit' ? '기초 설문 수정' : '기초 설문 등록'"></ui-tit>

				<text-badge variant="primary" txt="배포 중"></text-badge>
				<text-badge variant="error" txt="배포 전"></text-badge>
			</div>

			<div class="grid grid-cols-[150px] gap-2 has-[[icon-name=trash]]:grid-cols-[60px_150px]">
				<template x-if="$store.data.view === 'edit'">
					<ui-btn
						variant="icon"
						icon-name="trash"
						icon-cls="size-4 stroke-slate-400"
						class="rounded-sm border border-slate-200 bg-white"
						txt="삭제"></ui-btn>
				</template>
				<ui-btn variant="primary" cls="font-bold" txt="저장"></ui-btn>
			</div>
		</header>

		<ul class="order-3 inline-flex h-full flex-1 flex-col gap-3 overflow-x-clip overflow-y-auto p-1">
			<li class="shadow-1xs grid gap-5 rounded-lg bg-white px-5 py-4">
				<section class="col-span-2 grid grid-cols-[90px_1fr] gap-4">
					<ui-tit
						tag="h4"
						tit="설문명"
						tip="10자 이내 권장"
						tooltip="언어에 따라 표현 길이가 달라질 수 있으므로 <br />번역 내용을 확인해주세요. <strong>(최대 50자)</strong>"
					></ui-tit>
					<lang-translate data-max-length="50"> </lang-translate>
				</section>
			</li>

			<li class="shadow-1xs grid gap-5 rounded-lg bg-white px-5 py-4">
				<section class="grid grid-cols-[1fr_33px] items-center gap-5">
					<div>
						<ui-tit class="flex items-center gap-2" tag="h4" tit="설문 유형"></ui-tit>
					</div>
					<ui-checkbox variant="toggle"></ui-checkbox>
				</section>
			</li>

			<li class="shadow-1xs grid gap-5 rounded-lg bg-white px-5 py-4">
				<section class="grid grid-cols-[1fr_33px] items-center gap-5">
					<div>
						<ui-tit class="flex items-center gap-2" tag="h4" tit="AI 추천 활용"></ui-tit>
						<ui-txt size="xs" txt="응답이 AI 추천 기반 데이터로 활용됩니다. 의미가 명확한 항목으로 구성해 주세요."
						></ui-txt>
					</div>
					<ui-checkbox variant="toggle"></ui-checkbox>
				</section>
			</li>
		</ul>
	</div>
</LayoutBasic>

<div class="fixed bottom-5 left-25 z-5 inline-flex gap-2">
	<button @click.prevent="toast.success('배포 해제되었습니다.')">토스트</button>
	<button @click.prevent="toast.success('배포되었습니다.')">토스트</button>
	<button @click.prevent="toast.success('임시 저장되었습니다.')">토스트</button>
	<button @click.prevent="toast.success('삭제되었습니다.')">토스트</button>
	/
	<button @click.prevent="toast.error('다국어 이미지 등록 후 다시 시도해 주세요')">토스트</button>
	<button @click.prevent="toast.error('배포 해제할 기초 설문을 선택해 주세요.')">토스트</button>
	<button @click.prevent="toast.error('배포할 설문을 선택해 주세요.')">토스트</button>
	/
	<button @click.prevent="$store.alert.open('alert1')">알림1</button>
	<button @click.prevent="$store.alert.open('alert2')">알림2</button>
	<button @click.prevent="$store.alert.open('alert3')">알림3</button>
	<button @click.prevent="$store.alert.open('alert4')">알림4</button>
	<button @click.prevent="$store.alert.open('alert5')">알림5</button>
</div>

<alert-popup
	id="alert1"
	open="close"
	txt="배포 해제 시 사용자 지도에 즉시 비노출됩니다. <br />n건의 기초 설문 화면을 배포 해제하시겠습니까?"
	cancel="취소"
	@alert-cancel="alert()"
	@alert-confirm="alert()"></alert-popup>
<alert-popup
	id="alert2"
	open="close"
	txt="배포 시 사용자 지도에 즉시 반영됩니다.<br />n건의 기초 설문 화면을 배포하시겠습니까?"
	cancel="취소"
	@alert-cancel="alert()"
	@alert-confirm="alert()"></alert-popup>
<alert-popup
	id="alert3"
	open="close"
	txt="최대 10개까지 배포 가능합니다."
	cancel="취소"
	@alert-cancel="alert()"
	@alert-confirm="alert()"></alert-popup>
<alert-popup
	id="alert4"
	open="close"
	txt="$제목$ 기초 설문 화면을 삭제하시겠습니까?"
	cancel="취소"
	@alert-cancel="alert()"
	@alert-confirm="alert()"></alert-popup>
<alert-popup
	id="alert5"
	open="close"
	txt="배포 시 사용자 지도에 즉시 반영됩니다. <br />기초 설문 화면을 배포하시겠습니까?"
	cancel="취소"
	@alert-cancel="alert()"
	@alert-confirm="alert()"></alert-popup>

<script defer>
	document.addEventListener('alpine:init', () => {
		if (Alpine.store('data')) return;

		Alpine.store('data', {
			view: 'edit',
			loading: false,
			error: null,
			itemId: 1,
			items: Array.from({ length: 5 }, (_, idx) => ({
				id: idx + 1,
				tourDestinationId: 1,
				title: {
					ko: `기초 설문 ${idx + 1}`,
					en: 'Onboarding 1',
				},
				description: {
					ko: '설명',
					en: 'Description',
				},
				sortingNumber: null,
				deploymentStatus: idx < 2 ? 'DRAFT' : 'DEPLOYING',
				createdAt: '2026-07-11T12:23:15.300Z',
				updatedAt: null,
				onboardingFiles: [
					{
						id: 8,
						fileOriginalName: '',
						fileUrl: '',
						fileUploadPath: '',
						fileUploadName: '',
						fileSize: 1,
						fileMimeType: '',
						fileType: 'MAIN',
					},
				],
			})),
			data: {},
			colors: Array.from({ length: 12 }, (_, i) => i + 1),
			color: 1,
			isEventCategory: false,
			isAiRecommendationEnabled: false,
			isNavigationProvided: false,

			get deploymentItems() {
				return (this.items ?? []).filter((item) => item?.deploymentStatus === 'DEPLOYING').length;
			},

			setColor(list) {
				this.color = list;
			},

			currentItem(_id = '') {
				this.view = 'edit';
				this.itemId = _id;
			},

			async findInit(id = 1) {
				if (!id) return;
				this.data = this.items.find((v) => v.id === Number(id)) ?? {};
			},

			deploymentHandler(id = 1) {
				if (!id) return;
				this.data = this.items.find((v) => v.id === Number(id)) ?? {};
			},

			moveItemToStatus(id, status) {
				const item = this.items.find((v) => String(v.id) === String(id));
				if (!item) return;

				item.deploymentStatus = status;
			},

			syncItemsOrder(rootEl = document) {
				const deployingIds = [...rootEl.querySelectorAll('[data-status="DEPLOYING"] [data-id]')].map((el) =>
					String(el.dataset.id),
				);

				const draftIds = [...rootEl.querySelectorAll('[data-status="DRAFT"] [data-id]')].map((el) =>
					String(el.dataset.id),
				);

				const orderedIds = [...deployingIds, ...draftIds];
				const orderMap = new Map(orderedIds.map((id, idx) => [id, idx + 1]));

				this.items.forEach((item) => {
					const id = String(item.id);

					if (deployingIds.includes(id)) {
						item.deploymentStatus = 'DEPLOYING';
					} else if (draftIds.includes(id)) {
						item.deploymentStatus = 'DRAFT';
					}

					item.sortingNumber = orderMap.get(id) ?? null;
				});

				this.items.sort((a, b) => {
					const aOrder = orderMap.get(String(a.id)) ?? Number.MAX_SAFE_INTEGER;
					const bOrder = orderMap.get(String(b.id)) ?? Number.MAX_SAFE_INTEGER;
					return aOrder - bOrder;
				});

				if (this.itemId) {
					this.data = this.items.find((v) => String(v.id) === String(this.itemId)) ?? {};
				}
			},

			init() {
				this.findInit(1);
				Alpine.effect(() => {
					console.log(document.querySelectorAll('thumbnail-upload'));
				});
			},
		});
	});
</script>
