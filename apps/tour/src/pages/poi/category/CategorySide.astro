<section
	class="shadow-1xs flex h-full max-h-[calc(100dvh-100px)] flex-[0_0_320px] flex-col rounded-sm bg-white"
	data-dom="sidebar"
>
	<header class="grid flex-none grid-cols-[1fr_60px] items-center gap-3 px-5 pt-5 pb-3">
		<ui-tit
			class="col-span-1 flex items-center gap-2"
			size="lg"
			tit="카테고리"
			tooltip="카테고리에 노출 설정된 시설이 있을 경우에만 <br/>사용자 화면에 표시됩니다."></ui-tit>
		<div>
			<ui-btn class="bg-f5f5f5 col-span-1 w-15" variant="primary" size="md" txt="추가"></ui-btn>
		</div>
		<text-badge
			class="col-span-2"
			variant="bg-secondary"
			cls="text-[10px] w-full text-center"
			icon="info-circle-outline"
			txt="드래그로 항목 순서를 변경할 수 있으며, 즉시 적용됩니다."></text-badge>
	</header>

	<div class="grid flex-none grid-cols-2 items-center justify-between gap-3 px-5 pt-4 pb-2">
		<ui-tit class="col-span-1 flex items-center gap-2" size="lg" tit="일반 카테고리"></ui-tit>
		<div class="flex items-center justify-end gap-2">
			<ui-txt cls="text-cms-5 font-bold" size="xs" :txt="$store.data.generalCategory.length ?? 0"></ui-txt>
			<ui-txt size="xs" txt="개"></ui-txt>
		</div>
	</div>

	<div class="flex h-full min-h-0 flex-1 flex-col overflow-x-hidden overflow-y-auto">
		<ul class="flex h-full flex-1 flex-col divide-y divide-slate-200" x-sort>
			<template x-for="(item, idx) in $store.data.generalCategory" :key="idx">
				<li
					class="aria-current:bg-secondary aria-current:border-cms-3 grid items-center gap-2 border-t border-t-white px-5 py-3 has-[text-badge]:grid-cols-[1fr_28px] aria-current:border"
					:aria-current="$store.data.itemId === idx"
					@click.prevent="$store.data.currentItem(idx)"
				>
					<button
						type="button"
						class="grid grid-cols-[16px_32px_1fr] items-center gap-2"
						aria-label="Drag handle"
						x-sort:item
					>
						<icon-list data-name="dnd" class="size-4 fill-slate-300"></icon-list>
						<span class="grid size-8 place-content-center rounded-sm border border-slate-200 bg-slate-50">
							<icon-list
								:data-name="item?.icon"
								class="size-7"
								:style="`fill: var(--color-${item?.categoryColorCodeId}); stroke: var(--color-${item?.categoryColorCodeId})`"
							></icon-list>
						</span>
						<ui-tit
							class="text-left"
							tag="span"
							class="flex min-w-0 flex-col text-left"
							cls="truncate w-full inline-block"
							:tit="item?.name?.ko"
							:sub="`등록된 시설 ${item?._count?.facilities ?? 0}개`"></ui-tit>
					</button>
					<template x-if="item?.isAiRecommendationEnabled">
						<text-badge variant="primary" size="md" txt="Ai"></text-badge>
					</template>
				</li>
			</template>
		</ul>
	</div>

	<footer class="flex-none p-5 text-center">
		<ui-txt size="xs" txt="최대 12개까지 등록 가능합니다."></ui-txt>
	</footer>
</section>
