---
import LayoutBasic from '@/layouts/LayoutBasic.astro';
import CategorySide from '@/pages/poi/category/CategorySide.astro';
import DialogSubcategories from '@/src/components/modals/DialogSubcategories.astro';
---

<LayoutBasic>
	<div class="grid h-full w-[calc(100dvw-80px)] flex-1 grid-cols-[320px_1fr] grid-rows-[28px_1fr] gap-5 py-5 pl-5">
		<CategorySide />
		<header class="flex items-center justify-between">
			<ui-tit size="lg" :tit="$store.data.view === 'edit' ? '카테고리 수정' : '카테고리 등록'"></ui-tit>

			<div class="grid grid-cols-[150px] gap-2 px-5 py-3 has-[[icon-name=trash]]:grid-cols-[60px_150px]">
				<template x-if="$store.data.view === 'edit'">
					<ui-btn
						variant="icon"
						icon-name="trash"
						icon-cls="size-4 stroke-slate-400"
						class="rounded-sm border border-slate-200 bg-white"
						txt="삭제"></ui-btn>
				</template>
				<ui-btn variant="primary" cls="font-bold" txt="저장"></ui-btn>
			</div>
		</header>

		<div class="flex h-full flex-col gap-3 overflow-x-clip overflow-y-auto pr-5">
			<ul class="inline-flex min-w-xl flex-1 flex-col gap-3">
				<li class="shadow-1xs grid grid-cols-2 gap-5 rounded-lg bg-white px-5 py-4">
					<section class="col-span-2 grid grid-cols-[90px_1fr] gap-4">
						<ui-tit
							tag="h4"
							tit="카테고리명"
							tip="6 자 이내 권장"
							tooltip="언어에 따라 표현 길이가 달라질 수 <br />있으므로 번역 내용을 확인해주세요. (최대 15자)"
						></ui-tit>
						<lang-translate data-max-length="15"> </lang-translate>
					</section>

					<section class="col-span-1 grid grid-cols-[60px_1fr] gap-4">
						<ui-tit cls="justify-end" tag="h4" tit="아이콘"></ui-tit>
						<ul class="flex flex-wrap gap-2">
							<template x-for="icon in $store.data.icons" :key="icon">
								<li>
									<label
										class="has-checked:border-cms-3 has-checked:bg-secondary relative grid size-8 cursor-pointer place-content-center gap-2 rounded-sm border border-slate-200 bg-slate-50 select-none has-checked:border"
									>
										<input type="radio" :value="icon" x-model="$store.data.icon" class="peer sr-only" />
										<icon-list
											x-bind:data-name="icon"
											class="icon size-7 fill-slate-500 stroke-slate-500 transition-all"
											:style="$store.data.icon === icon ? `fill: var(--color-poi-${$store.data.color}); stroke: var(--color-poi-${$store.data.color});` : ''"
										></icon-list>
									</label>
								</li>
							</template>
						</ul>
					</section>

					<section class="col-span-1 grid grid-cols-[60px_1fr] gap-4">
						<ui-tit cls="justify-end" tag="h4" tit="색상"></ui-tit>
						<ul class="flex flex-wrap gap-2">
							<template x-for="color, idx in $store.data.colors" :key="color">
								<li>
									<label
										class="has-checked:border-cms-3! has-checked:bg-secondary relative grid size-8 cursor-pointer place-items-center rounded-full border-2 border-transparent select-none"
										:style="`border-color: var(--color-poi-outline-${color});`"
									>
										<input type="radio" :value="color" x-model="$store.data.color" class="peer sr-only" />
										<template x-if="$store.data.color == color">
											<icon-list
												data-name="check"
												class="icon pointer-events-none absolute top-1/2 left-1/2 h-2.5 w-3.5 -translate-x-1/2 -translate-y-1/2 stroke-white transition-all"
												x-transition:enter="transition ease-out duration-300"
												x-transition:enter-start="opacity-0 scale-0"
												x-transition:enter-end="opacity-100 scale-100"
												x-transition:leave="transition ease-in duration-300"
												x-transition:leave-start="opacity-100 scale-100"
												x-transition:leave-end="opacity-0 scale-90"></icon-list>
										</template>
										<span
											class="size-full rounded-full"
											:style="`background-color: var(--color-poi-${color});`"
										>
										</span>
									</label>
								</li>
							</template>
						</ul>
					</section>
				</li>

				<li class="shadow-1xs grid gap-5 rounded-lg bg-white px-5 py-4">
					<section class="grid grid-cols-[1fr_33px] gap-5">
						<div>
							<ui-tit
								class="flex items-center gap-2"
								tag="h4"
								tit="이벤트 카테고리"
								tooltip="일반 카테고리보다 우선 노출되며 강조된 형태로 표시됩니다."></ui-tit>
							<ui-txt size="xs" txt="일반 카테고리보다 우선 노출되며 강조된 형태로 표시됩니다."></ui-txt>
						</div>
						<ui-checkbox
							variant="toggle"
							:checked="$store.data.isEventCategory"
							@checked-change="$store.data.isEventCategory = $event.detail.checked"></ui-checkbox>
					</section>
				</li>

				<li class="grid grid-cols-1 gap-3">
					<section class="shadow-1xs grid flex-1 grid-cols-[1fr_33px] items-center gap-5 rounded-lg bg-white px-5 py-4">
						<div>
							<ui-tit class="flex items-center gap-2" tag="h4" tit="AI 추천 설정"></ui-tit>
							<ui-txt size="xs" txt="AI 시설 추천 결과에 이 카테고리 시설을 포함합니다"></ui-txt>
						</div>
						<ui-checkbox
							variant="toggle"
							:checked="$store.data.isAiRecommendationEnabled"
							@checked-change="$store.data.isAiRecommendationEnabled = $event.detail.checked"></ui-checkbox>
					</section>
				</li>

				<li class="shadow-1xs rounded-lg bg-white px-5 py-4">
					<section class="grid gap-3">
						<div>
							<ui-tit class="flex items-center gap-2" tag="h4" tit="썸네일 이미지" req></ui-tit>
							<ui-txt size="xs" txt="이 카테고리 시설에 썸네일이 없을 때 표시되는 기본 이미지입니다."></ui-txt>
						</div>
						<thumbnail-upload cls="flex w-full h-20 has-[img]:size-20" size="full"></thumbnail-upload>
					</section>
				</li>

				<li class="shadow-1xs grid grid-cols-1 items-center gap-5 rounded-lg bg-white py-4">
					<section class="grid grid-cols-[1fr_60px] place-content-between gap-3 px-5">
						<ui-tit class="flex items-center gap-2" req tag="h4" tit="하위 카테고리"></ui-tit>
						<div>
							<ui-btn
								class="bg-f5f5f5 col-span-1 w-15"
								variant="primary"
								size="md"
								txt="추가"
								x-bind="ModalHandler"
								data-target="DialogSubcategories"
								@btn-click="$store.modal.edit = ''"></ui-btn>
						</div>
					</section>
					<ul
						class="flex h-full min-h-0 flex-1 flex-col divide-y divide-slate-200 overflow-x-hidden overflow-y-auto"
						x-sort
					>
						<template x-if="$store.data.data.children.length === 0">
							<li class="grid place-content-center gap-3 py-10">
								<ui-txt
									class="flex items-center gap-2 text-center"
									txt="하위 카테고리를 추가하고 <br />시설을 세분화하여 관리해 보세요"></ui-txt>
								<div class="inline-grid place-content-center">
									<ui-btn cls="min-w-30" variant="ghost" txt="카테고리 추가하기"></ui-btn>
								</div>
							</li>
						</template>
						<template x-for="(item, idx) in $store.data.data.children" :key="idx">
							<li class="group/dnd grid grid-cols-[1fr_124px] gap-2 px-5 py-3">
								<button
									type="button"
									class="handle grid items-center gap-2 has-data-[name=dnd]:grid-cols-[16px_1fr]"
									aria-label="Drag handle"
									:x-sort:item="`dnd-general-${idx}`"
								>
									<template x-if="$store.data.data.children.length > 1">
										<icon-list data-name="dnd" class="group-aria-current/dnd:fill-cms-3 size-4 fill-slate-300"
										></icon-list>
									</template>
									<ui-tit
										class="text-left"
										cls="font-normal"
										tag="p"
										tit="하위 카테고리"
										:sub="`등록된 시설 ${item._count.facilities ?? '0'}개`"></ui-tit>
								</button>

								<div class="grid grid-cols-[repeat(2,60px)] gap-2">
									<ui-btn
										variant="secondary"
										txt="수정"
										x-bind="ModalHandler"
										data-target="DialogSubcategories"
										@btn-click="$store.modal.edit = 'edit'"></ui-btn>
									<ui-btn variant="ghost" txt="삭제"></ui-btn>
								</div>
							</li>
						</template>
					</ul>
				</li>
			</ul>
		</div>
	</div>
</LayoutBasic>

<DialogSubcategories />

<div class="fixed bottom-5 left-25 z-5 inline-flex gap-2">
	<button @click.prevent="toast.success('삭제되었습니다.')">토스트</button>
	<button @click.prevent="toast.success('저장되었습니다.')">토스트</button>
	/
	<button @click.prevent="$store.alert.open('alert1')">알림</button>
	/
	<button @click.prevent="$store.alert.open('alert2')">알림</button>
	/
	<button @click.prevent="$store.alert.open('alert3')">알림</button>
</div>

<alert-popup id="alertImg" open="close" txt="이미지 확장자(jpg, png)만 첨부 가능합니다."></alert-popup>
<alert-popup id="alertImgSize" open="close" txt="2MB 이하의 파일만 첨부 가능합니다."></alert-popup>
<alert-popup
	id="alert1"
	open="close"
	txt="등록된 시설은 하위 카테고리 미선택 상태로 변경되며 <br />카테고리 저장 후 최종 반영됩니다. <br />삭제하시겠습니까?"
	cancel="취소"
	@alert-cancel="alert()"
	@alert-confirm="alert()"></alert-popup>
<alert-popup
	id="alert2"
	open="close"
	txt="$시설명$ 카테고리를 삭제하시겠습니까? <br />이 작업은 되돌릴 수 없습니다."
	cancel="취소"
	@alert-cancel="alert()"
	@alert-confirm="alert()"></alert-popup>
<alert-popup
	id="alert3"
	open="close"
	txt="등록된 시설이 있는 카테고리는 삭제가 불가합니다. <br />시설 수정 후 다시 시도해주세요."
	cancel="취소"
	@alert-cancel="alert()"
	@alert-confirm="alert()"></alert-popup>

<script defer>
	document.addEventListener('alpine:init', () => {
		if (Alpine.store('data')) return;

		Alpine.store('data', {
			view: 'edit',
			loading: false,
			error: null,
			itemId: 1,
			items: Array.from({ length: 12 }, (_, idx) => ({
				name: {
					ko: `대상지명대상지명대상지명대상지명대상지명${idx + 1}`,
					en: `tour_destination_${idx + 1}`,
					zh: '',
					ja: '',
					th: '',
					vi: '',
				},
				categoryColorCodeId: `poi-${idx + 1}`,
				icon: 'location',
				_count: {
					facilities: 10,
				},
				id: idx + 1,
				sortingNumber: idx + 1,
				isEventCategory: idx < 2 ? true : false,
				isAiRecommendationEnabled: idx === 0 ? true : false,
				isVisible: idx === 0 ? true : false,

				children: [
					{
						_count: {
							facilities: 1,
						},
						sortingNumber: 1,
						iconUrl: 'location',
						name: {
							ko: '1번 위치1번 위치1번 위치1번 위치1번 위치1번 위치1번 위치',
							en: '',
						},
						id: 1,
					},
					{
						_count: {
							facilities: 1,
						},
						sortingNumber: 1,
						iconUrl: 'location',
						name: {
							ko: '1번 위치1번 위치1번 위치1번 위치1번 위치1번 위치1번 위치',
							en: '',
						},
						id: 1,
					},
				],
			})),
			data: {},
			icons: [
				'location',
				'binoculars',
				'ticket',
				'information',
				'coffee',
				'food',
				'meat',
				'fish',
				'apple',
				'shopping',
				'three',
				'flag',
				'smoking',
				'stroller',
				'medical',
				'toilet',
				'wheelchair',
				'parking',
				'transport',
				'camera',
				'coin',
				'popper',
				'phone',
				'etc',
			],
			icon: 'location',
			colors: Array.from({ length: 12 }, (_, i) => i + 1),
			color: 1,
			isEventCategory: false,
			isAiRecommendationEnabled: false,
			isNavigationProvided: false,

			setIcon(list) {
				this.icon = list;
			},

			setColor(list) {
				this.color = list;
			},

			currentItem(_id = '') {
				this.view = 'edit';
				this.itemId = _id;
			},

			async findInit(id = 1) {
				if (!id) return;
				this.data = this.items.find((v) => v.id === Number(id)) ?? {};
			},

			init() {
				this.findInit(1);
				// Alpine.effect(() => {
				// 	console.log('store init', this.icon);
				// 	console.log(this.isEventCategory, this.isAiRecommendationEnabled, this.isNavigationProvided);
				// });
			},
		});
	});
</script>
