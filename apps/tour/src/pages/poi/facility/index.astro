---
import LayoutBasic from '@/layouts/LayoutBasic.astro';
import FacilitiesSide from '@/pages/poi/facility/FacilitiesSide.astro';
---

<LayoutBasic>
	<div class="flex w-[calc(100dvw-80px)] flex-1 gap-5 p-5">
		<article class="flex min-w-xl flex-1 flex-col gap-3">
			<section class="shadow-1 shadow-1xs space-y-2 rounded-sm bg-white p-5">
				<div class="flex flex-wrap items-center justify-between gap-2">
					<div class="flex flex-wrap items-center gap-2">
						<h3>검색 조건</h3>
						<ui-btn variant="icon" icon-name="rotate-left" icon-cls="size-4 stroke-slate-500"></ui-btn>
					</div>
					<div class="flex items-center gap-2">
						<ui-btn
							variant="ghost"
							size="lg"
							cls="min-w-30"
							icon-name="arrow-up"
							icon-pos="lt"
							icon-cls="size-3 stroke-slate-400"
							txt="엑셀 업로드"
							@click.prevent="$store.data.setView('reg'); window.location = '/tour-destination/reg/'"></ui-btn>
						<ui-btn
							variant="primary"
							size="lg"
							cls="min-w-30"
							icon-name="arrow-up"
							icon-pos="lt"
							icon-cls="size-3 stroke-white"
							txt="시설 추가"
							@click.prevent="$store.data.setView('reg'); window.location = '/tour-destination/reg/'"></ui-btn>
					</div>
				</div>

				<div class="flex flex-wrap items-center justify-between gap-2">
					<div class="inline-flex items-center gap-2">
						<select class="select min-w-62.5" name="status">
							<option value="all">전체 카테고리</option>
							<option value="open">운영 중 (n개)</option>
							<option value="before">운영 전 (n개)</option>
							<option value="closed">운영 종료 (n개)</option>
						</select>

						<select class="select min-w-62.5" name="matching">
							<option value="all">매칭 전 + 완료</option>
							<option value="pending">매칭 전</option>
							<option value="done">매칭 완료</option>
						</select>
					</div>
					<div>
						<div
							class="input-search group/input-search relative"
							x-data="{ focused: false, keyword: '' }"
							@focusin="focused = true"
							@focusout="focused = false"
						>
							<input class="input-text peer pr-15!" x-model="keyword" type="text" placeholder="위치 검색" />

							<div class="absolute top-1.5 right-2 z-2 bg-white">
								<ui-btn
									x-show="focused"
									x-cloak
									variant="icon"
									icon-name="input-del"
									icon-cls="size-4 stroke-slate-400"
									x-on:click="keyword = ''"></ui-btn>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="shadow-1 shadow-1xs space-y-4 rounded-sm bg-white p-5">
				<div class="inline-flex items-center gap-4">
					<select class="select w-37.5" id="" name="">
						<option value="">10개씩 보기</option>
					</select>
					<select class="select w-37.5" id="" name="">
						<option value="">최신순</option>
						<option value="">가나다순</option>
					</select>

					<div class="inline-flex flex-wrap gap-4">
						<ui-checkbox item-id="thumb-none-chk" txt="썸네일 없음" class="flex-none"></ui-checkbox>
						<ui-checkbox item-id="congestion=usage-chk" txt="혼잡도 사용" class="flex-none"></ui-checkbox>
						<ui-checkbox item-id="location-based-chk" txt="위치 기반 콘텐츠 사용" class="flex-none"></ui-checkbox>
					</div>

					<div class="grid grid-cols-[60px_1fr] gap-2 px-5 py-3">
						<ui-btn
							variant="ghost"
							size="lg"
							icon-name="trash"
							icon-cls="size-5 stroke-slate-400"
							icon-pos="lt"
							class="w-22.25"
							txt="삭제"></ui-btn>
					</div>
				</div>

				<div class="table-wrap">
					<table>
						<colgroup>
							<col style="width: 50px" />
							<col style="width: 60px" />
							<col style="width: *" />
							<col style="width: 140px" />
							<col style="width: 140px" />
							<col style="width: 100px" />
							<col style="width: 80px" />
							<col style="width: 120px" />
							<col style="width: 120px" />
						</colgroup>
						<thead>
							<tr>
								<th scope="row">
									<ui-checkbox item-id="all-chk"></ui-checkbox>
								</th>
								<th scope="row">NO.</th>
								<th class="text-left" scope="row">시설명</th>
								<th class="text-left" scope="row">카테고리</th>
								<th class="text-left" scope="row">운영기간</th>
								<th class="text-left" scope="row">공통 링크</th>
								<th class="text-left" scope="row">상품</th>
								<th class="text-left" scope="row">매칭 위치</th>
								<th class="text-left" scope="row">수정일시</th>
							</tr>
						</thead>
						<tbody>
							<template
								x-for="(item, idx) in $store.data.items.slice(($store.data.page - 1) * $store.data.pageSize, $store.data.page * $store.data.pageSize)"
								:key="item.id"
							>
								<tr
									class="group/tr"
									:class="$store.data.itemId === item.id ? 'bg-secondary border border-cms-3' : ''"
									:aria-selected="$store.data.itemId === item.id ? 'true' : 'false'"
								>
									<td>
										<ui-checkbox x-bind:item-id="item.id"></ui-checkbox>
									</td>
									<td>
										<ui-txt size="sm" cls="text-center text-black" x-bind:txt="idx + 1"></ui-txt>
									</td>
									<td>
										<ui-txt
											role="button"
											size="sm"
											cls="text-left text-black cursor-pointer"
											x-bind:txt="item.name.ko"
											@click="$store.data.sideView(item.id)"></ui-txt>
									</td>
									<td>
										<div class="flex items-center justify-start gap-1">
											<template x-if="item.category.name.ko">
												<ui-txt size="sm" cls="text-left text-black" x-bind:txt="item.category.name.ko"
												></ui-txt>
											</template>
											<template x-if="item.category?.parent">
												<ui-txt
													size="sm"
													cls="text-left text-black"
													:txt="'/ ' + item.category.parent.name.ko"></ui-txt>
											</template>
										</div>
									</td>
									<td>
										<template x-if="item.isAlways">
											<p class="text-left">상시운영</p>
										</template>

										<template x-if="!item.isAlways">
											<div>
												<text-date x-bind:dateTime="item.startAt"></text-date>
												<div class="flex">~<text-date x-bind:dateTime="item.endAt"></text-date></div>
											</div>
										</template>
									</td>
									<td>
										<template x-if="item.facilityButtons.length === 0">
											<ui-txt size="sm" cls="text-left text-slate-500" txt="미사용"></ui-txt>
										</template>
										<template x-if="item.facilityButtons.length">
											<ui-txt
												size="sm"
												cls="text-cms-4 text-left"
												:txt="'사용 (' + item.facilityButtons.filter(btn => btn.tourDestinationCommonButtonId != null).length + '/' + item.facilityButtons.length + ')'"
											></ui-txt>
										</template>
									</td>
									<td>
										<ui-txt size="sm" cls="text-left text-slate-500" txt="0개"></ui-txt>
										<ui-txt size="sm" cls="text-cms-4 text-left" txt="1개"></ui-txt>
									</td>
									<td class="text-left">
										<template x-if="item.facilityPoiMappings.length === 0">
											<text-badge tooltip variant="error" txt="매칭전"></text-badge>
										</template>
										<template
											x-if="item.facilityPoiMappings.length && item.facilityPoiMappings[0].poi.name.ko === ''"
										>
											<text-badge tooltip variant="bg-slate" txt="이름 없음"></text-badge>
										</template>
										<template
											x-if="item.facilityPoiMappings.length && item.facilityPoiMappings[0].poi.name.ko !== ''"
										>
											<text-badge
												tooltip
												variant="primary"
												date-ellipsis="true"
												cls="max-w-30"
												x-bind:txt="item.facilityPoiMappings[0].poi.name.ko"></text-badge>
										</template>
									</td>

									<td class="text-left">
										<text-date data-time-view="time" x-bind:dateTime="item.updatedAt"></text-date>
									</td>
								</tr>
							</template>

							<tr>
								<td colspan="9"></td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>

			<paging-table
				x-bind:data-page="$store.data.page"
				x-bind:data-page-size="$store.data.pageSize"
				x-bind:data-total-count="$store.data.totalCount"
				x-bind:data-total-pages="$store.data.totalPages"
				@btn-prev="console.log('prev', $event.detail); $store.data.prevView($event.detail)"
				@btn-next="console.log('next', $event.detail); $store.data.nextView($event.detail)"
				@btn-current="console.log('current', $event.detail); $store.data.currentView($event.detail.page)"
			>
			</paging-table>
		</article>

		<FacilitiesSide />
	</div>

	<alert-popup class="fixed top-0 left-0" txt="" confirm="확인" cancel="취소" open="close"></alert-popup>
</LayoutBasic>

<script defer>
	document.addEventListener('alpine:init', () => {
		if (Alpine.store('data')) return;
		Alpine.store('data', {
			items: [],
			data: {},
			pageSize: 10,
			totalCount: 1,
			totalPages: 1,
			loading: false,
			error: null,
			itemId: 0,
			sidebar: false,
			async fetchData() {
				this.loading = true;
				try {
					const res = await fetch(`/api/facility`);

					const data = await res.json();
					const payload = data.data.data ?? {};

					this.items = payload.items;
					this.data = payload.items[0];
					this.page = payload.page;
					this.pageSize = payload.pageSize;
					this.totalCount = payload.totalCount;
					this.totalPages = payload.totalPages;
				} catch (error) {
					this.error = error.message;
					console.error('데이터 로드 실패:', error);
				} finally {
					this.loading = false;
				}
			},
			prevView(detail) {
				const nextPage = Math.max(1, Number(detail.page) - 8);
				this.page = nextPage;
			},
			nextView(detail) {
				const nextPage = Math.min(Math.max(1, Number(detail.totalPages) || 1), Number(detail.page) + 8);
				this.page = nextPage;
			},
			currentView(page) {
				const nextPage = Math.max(1, Number(page) || 1);
				this.page = nextPage;
			},

			async findInit(id = 0) {
				if (!id) return;
				this.data = this.items.find((v) => v.id === Number(id)) ?? {};
			},
			sideView(id = 0) {
				this.sidebar = true;
				this.itemId = id;
				this.findInit(id);
			},
			async init() {
				await this.fetchData(1);
			},
		});
	});
</script>
