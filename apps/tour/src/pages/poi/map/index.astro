---
import LayoutBasic from '@/layouts/LayoutBasic.astro';
import MapList from '@/pages/poi/map/MapList.astro';
import MapReg from '@/pages/poi/map/MapReg.astro';
import DialogFacilityRegistration from '@/src/components/modals/DialogFacilityRegistration.astro';
---

<LayoutBasic>
	<div x-show="$store.data.sidebar === 'reg'" x-transition class="absolute top-5 left-5 z-5">
		<top-tooltip variant="bg-secondary" tit="지도를 우클릭하여 위치 변경" checked="chk"></top-tooltip>
	</div>

	<div x-show="$store.data.sidebar === 'init'" x-transition class="absolute top-5 left-5 z-5">
		<top-tooltip tit="지도를 우클릭하여 새 위치 생성" checked="chk"></top-tooltip>
	</div>

	<div class="absolute top-5 right-85 z-5">
		<ui-btn class="min-w-37.5" variant="ghost" size="lg" txt="오버레이 설정"></ui-btn>
	</div>

	<div class="grid h-full grid-cols-[1fr_20rem]">
		<section id="map_div" class="grid size-full"></section>
		<div class="absolute right-85 bottom-5 z-5 space-y-3">
			<ui-btn class="size-11 rounded-sm bg-white" variant="icon" icon-name="refresh" icon-cls="size-7 stroke-black"
			></ui-btn>
			<ui-btn class="size-11 rounded-sm bg-white" variant="icon" icon-name="gps" icon-cls="size-7 stroke-black"></ui-btn>
		</div>

		<MapList />
	</div>
	<MapReg />
	<DialogFacilityRegistration />
</LayoutBasic>

<div class="fixed bottom-5 left-25 z-5 inline-flex gap-2">
	<button @click.prevent="toast.success('저장되었습니다.')">토스트</button>
	/
	<button @click.prevent="toast.success('비노출 상태로 저장되었습니다.')">토스트</button>
	<button @click.prevent="toast.success('불러온 T맵 위치가 저장되었습니다. ')">토스트</button>
	/
	<button @click.prevent="toast.error('비노출 상태로 저장되었습니다.')">토스트</button>
	<button @click.prevent="toast.error('위치를 선택해 주세요.')">토스트</button>
	/
	<button @click.prevent="$store.alert.open('alert1')">알림1</button>
	/
	<button @click.prevent="$store.alert.open('alert2')">알림2</button>
	/
	<button @click.prevent="$store.alert.open('alert3')">알림3</button>
	/
	<button @click.prevent="$store.alert.open('alert4')">알림4</button>
</div>

<alert-popup
	id="alert1"
	open="close"
	txt="작성 중인 내용이 저장되지 않았습니다. <br />이 페이지를 벗어나시겠습니까?"
	cancel="취소"
	@alert-cancel="alert()"
	@alert-confirm="alert()"></alert-popup>
<alert-popup
	id="alert2"
	open="close"
	txt="저장 시 사용자 지도에 즉시 반영됩니다. <br />저장하시겠습니까?"
	cancel="취소"
	@alert-cancel="alert()"
	@alert-confirm="alert()"></alert-popup>
<alert-popup
	id="alert3"
	open="close"
	txt="시설 정보로 이동하시겠습니까?"
	cancel="취소"
	@alert-cancel="alert()"
	@alert-confirm="alert()"></alert-popup>
<alert-popup
	id="alert4"
	open="close"
	txt="작성 중인 위치 내용이 저장되지 않았습니다. <br />바로 시설 정보로 이동하시겠습니까?"
	cancel="취소"
	@alert-cancel="alert()"
	@alert-confirm="alert()"></alert-popup>

<script defer>
	document.addEventListener('alpine:init', () => {
		if (Alpine.store('data')) return;
		Alpine.store('data', {
			items: [],
			data: {},
			pageSize: 10,
			totalCount: 1,
			totalPages: 1,
			loading: false,
			error: null,
			itemId: 0,
			sidebar: 'reg', // 'init' | 'reg' | 'overlay' | 'confusion'
			sidebarTopVisible: true,
			sidebarChkVisible: false,
			toast: [],
			async fetchData() {
				this.loading = true;
				try {
					const res = await fetch(`/api/pois`);

					const data = await res.json();
					const payload = data.data ?? {};

					this.items = payload.items;
					this.page = payload.page;
					this.pageSize = payload.pageSize;
					this.totalCount = payload.totalCount;
					this.totalPages = payload.totalPages;
				} catch (error) {
					this.error = error.message;
					console.error('데이터 로드 실패:', error);
				} finally {
					this.loading = false;
				}
			},

			async findInit(id = 0) {
				if (!id) return;
				this.data = this.items.find((v) => v.id === Number(id)) ?? {};
			},

			sideView(id = 0) {
				this.sidebar = 'reg';
				this.itemId = id;
				this.findInit(id);
			},
			async init() {
				await this.fetchData(1);
			},
		});
	});
</script>

<script>
	import MapController from './mapEvent';

	window.addEventListener('load', () => {
		if (!window.Tmapv3) {
			console.error('Tmapv3 is not loaded');
			return;
		}

		const mapController = new MapController();
		mapController.init();
	});
</script>
