---
import LayoutBasic from '@/layouts/LayoutBasic.astro';

const { view, id } = Astro.params;
---

<LayoutBasic>
	<div class="grid w-full min-w-5xl">
		<section class="sticky top-0 z-5 w-full space-y-2 bg-slate-50 p-5 transition-all">
			<div class="flex items-center justify-between">
				<div>
					<template x-if="$store.data.view === 'reg'">
						<ui-tit tag="h2" size="lg" tit="대상지 등록"></ui-tit>
					</template>

					<template x-if="$store.data.view === 'edit'">
						<ui-tit tag="h2" size="lg" tit="대상지 수정"></ui-tit>
					</template>

					<template x-if="$store.data.view === 'detail'">
						<ui-tit tag="h2" size="lg" :tit="$store.data.data?.name?.ko ?? ''"></ui-tit>
					</template>
				</div>

				<div class="flex items-center gap-3">
					<template x-if="$store.data.view === 'detail'">
						<div class="flex gap-3">
							<ui-btn class="w-20" variant="ghost" size="lg" txt="목록"></ui-btn>

							<ui-btn class="w-20" variant="ghost" size="lg" txt="삭제"></ui-btn>

							<ui-btn
								class="w-20"
								variant="primary"
								size="lg"
								txt="수정"
								@click.prevent="$store.data.setView('edit')"></ui-btn>
						</div>
					</template>

					<template x-if="$store.data.view === 'edit' || $store.data.view === 'reg'">
						<ui-btn
							class="w-20"
							variant="primary"
							size="lg"
							txt="저장"
							@click="console.log(document.querySelector('operating-period').isAlways)"></ui-btn>
					</template>
				</div>
			</div>

			<template x-if="$store.data.view !== 'detail'">
				<div class="flex items-center">
					<ui-tit class="px-4.5" tit="섹션"></ui-tit>

					<div class="flex items-center gap-3">
						<ui-btn
							class="w-60 gap-3"
							tag="label"
							variant="segmented"
							size="lg"
							name="tab-section"
							:arr="JSON.stringify(['대상지 정보', '커스텀 항목'] ?? [])"
							scroll="tab-section"></ui-btn>
					</div>
				</div>
			</template>
		</section>

		<article class="px-5 pb-5">
			<section class="shadow-1xs space-y-3 rounded-lg bg-white p-5" id="target-scroll-tab-section-0">
				<ui-tit tag="h3" size="lg" tit="대상지 정보"></ui-tit>

				<ul class="divide-y divide-slate-300">
					<li>
						<div
							class="grid max-w-375 grid-cols-[240px_1fr] gap-5 px-4 py-5 has-[[view=detail]]:grid-cols-[122px_1fr]"
						>
							<template x-if="$store.data.view === 'detail'">
								<ui-tit tit="제공 언어"></ui-tit>
							</template>
							<template x-if="$store.data.view !== 'detail'">
								<ui-tit tit="제공 언어" sub="사용자에게 제공할 언어를 선택해 주세요"></ui-tit>
							</template>

							<template x-if="$store.data.view === 'reg'">
								<lang-chk class="flex flex-wrap items-center justify-end gap-5" view="reg"></lang-chk>
							</template>
							<template x-if="$store.data.view !== 'reg'">
								<lang-chk
									class="flex flex-wrap items-center justify-end gap-5"
									:view="$store.data.view"
									:lang="JSON.stringify($store.data.data?.supportedLanguages)"></lang-chk>
							</template>
						</div>
					</li>
					<li>
						<div
							class="grid max-w-375 grid-cols-[100px_1fr] gap-5 px-4 py-5 has-[[view=detail]]:grid-cols-[122px_1fr]"
						>
							<template x-if="$store.data.view === 'detail'">
								<ui-tit tit="다국어 대상지명"></ui-tit>
							</template>
							<template x-if="$store.data.view !== 'detail'">
								<ui-tit
									tit="대상지명"
									tip="15자 이내 권장"
									tooltip="언어에 따라 표현 길이가 달라질 수 <br />있으므로 번역 내용을 확인해주세요. (최대 50자)"
								></ui-tit>
							</template>

							<template x-if="$store.data.view === 'reg'">
								<lang-translate class="flex-1" data-max-length="50" :view="$store.data.view"></lang-translate>
							</template>
							<template x-if="$store.data.view !== 'reg'">
								<lang-translate
									class="flex-1"
									data-max-length="50"
									:view="$store.data.view"
									:lang="JSON.stringify($store.data.data?.name ?? {})"></lang-translate>
							</template>
						</div>
					</li>

					<li>
						<div
							class="grid max-w-375 grid-cols-[100px_1fr] gap-5 px-4 py-5 has-[[view=detail]]:grid-cols-[122px_1fr]"
						>
							<ui-tit tit="위치" cls="h-full items-center"></ui-tit>
							<div class="flex flex-wrap items-center gap-5">
								<ui-txt size="sm" txt="지도의 중심 좌표를 선택해 주세요"></ui-txt>
								<ui-btn class="min-w-30" variant="ghost" size="md" txt="지도에서 선택하기"></ui-btn>
								<ui-txt size="sm" txt="서울특별시 용산구 이태원로 29 (한강로1가)" cls="text-black"></ui-txt>
							</div>
						</div>
					</li>

					<li>
						<div
							class="grid max-w-375 grid-cols-[100px_1fr_100px_1fr] gap-5 px-4 py-5 has-[[view=detail]]:grid-cols-[122px_1fr_122px_1fr]"
						>
							<ui-tit tit="운영 기간" cls="pt-1"></ui-tit>

							<template x-if="$store.data.view === 'reg'">
								<operating-period :view="$store.data.view"></operating-period>
							</template>
							<template x-if="$store.data.view === 'edit'">
								<operating-period
									:view="$store.data.view"
									:is-always="$store.data.data?.isAlways ?? false"
									:start-at="$store.data.data?.startAt"
									:end-at="$store.data.data?.endAt"></operating-period>
							</template>
							<div class="flex items-center">
								<template x-if="$store.data.data.isAlways">
									<p class="text-left">상시운영</p>
								</template>
								<template x-if="!$store.data.data.isAlways">
									<text-date :dateTime="$store.data.data.startAt"></text-date>
								</template>
								<template x-if="!$store.data.data.isAlways">
									<text-date :dateTime="$store.data.data.endAt"></text-date>
								</template>
							</div>

							<ui-tit tit="정기 휴무" cls="pt-1"></ui-tit>

							<template x-if="$store.data.view === 'reg'">
								<closing-day :view="$store.data.view"></closing-day>
							</template>
							<template x-if="$store.data.view !== 'reg'">
								<closing-day
									:view="$store.data.view"
									:result="JSON.stringify($store.data.data?.tourDestinationHolidaySchedules)"></closing-day>
							</template>
						</div>
					</li>

					<li>
						<div
							class="grid max-w-375 grid-cols-[100px_1fr] gap-5 px-4 py-5 has-[[view=detail]]:grid-cols-[122px_1fr]"
						>
							<ui-tit tit="운영 시간"></ui-tit>

							<template x-if="$store.data.view !== 'reg'">
								<operating-hours
									rest="off"
									:view="$store.data.view"
									:result="JSON.stringify($store.data.data?.tourDestinationOperatingSchedules)"
								></operating-hours>
							</template>
							<template x-if="$store.data.view === 'reg'">
								<operating-hours rest="off" :view="$store.data.view"></operating-hours>
							</template>
						</div>
					</li>

					<li>
						<div
							class="grid max-w-375 grid-cols-[100px_1fr] gap-5 px-4 py-5 has-[[view=detail]]:grid-cols-[122px_1fr]"
						>
							<template x-if="$store.data.view === 'detail'">
								<ui-tit tit="운영 안내"></ui-tit>
							</template>
							<template x-if="$store.data.view !== 'detail'">
								<ui-tit
									tit="운영 안내"
									req
									tip="30자 이내 권장"
									tooltip="언어에 따라 표현 길이가 달라질 수 <br />있으므로 번역 내용을 확인해주세요. (최대 60자)"
								></ui-tit>
							</template>

							<template x-if="$store.data.view !== 'reg'">
								<lang-translate
									data-max-length="50"
									:view="$store.data.view"
									:lang="JSON.stringify($store.data.data?.operationGuide ?? {})"></lang-translate>
							</template>
							<template x-if="$store.data.view === 'reg'">
								<lang-translate data-max-length="50" :view="$store.data.view"></lang-translate>
							</template>
						</div>
					</li>

					<li>
						<div
							class="grid max-w-375 grid-cols-[200px_1fr] gap-5 px-4 py-5 has-[[view=detail]]:grid-cols-[122px_1fr]"
						>
							<template x-if="$store.data.view === 'detail'">
								<ui-tit tit="홈페이지 링크"></ui-tit>
							</template>
							<template x-if="$store.data.view !== 'detail'">
								<ui-tit tit="홈페이지 링크" req sub="사용자에게 제공할 링크를 작성해 주세요"></ui-tit>
							</template>

							<template x-if="$store.data.view === 'detail'">
								<ui-btn
									tag="a"
									variant="underline"
									size="md"
									cls="underline-offset-1 gap-4 break-all"
									icon-name="link"
									icon-pos="lt"
									icon-cls="size-3 stroke-black flex"
									:view="$store.data.view"
									:txt="$store.data.data?.homepageUrl ?? ''"
									:link="$store.data.data?.homepageUrl ?? ''"></ui-btn>
							</template>
							<template x-if="$store.data.view !== 'detail'">
								<input-text
									data-type="url"
									placeholder="https://(또는 http://)를 포함하여 URL를 입력해주세요"
									:view="$store.data.view"
									:value="$store.data.data?.homepageUrl ?? ''"></input-text>
							</template>
						</div>

						<div
							class="grid max-w-375 grid-cols-[200px_1fr] gap-5 px-4 py-5 has-[[view=detail]]:grid-cols-[122px_1fr]"
						>
							<template x-if="$store.data.view === 'detail'">
								<ui-tit tit="사용자 지도 링크"></ui-tit>
							</template>
							<template x-if="$store.data.view !== 'detail'">
								<ui-tit tit="사용자 지도 링크" req></ui-tit>
							</template>

							<template x-if="$store.data.view === 'detail'">
								<ui-btn
									tag="a"
									variant="underline"
									size="md"
									cls="underline-offset-1 gap-4 break-all"
									icon-name="link"
									icon-pos="lt"
									icon-cls="size-3 stroke-black flex"
									:view="$store.data.view"
									:txt="$store.data.data?.mapUrl ?? ''"
									:link="$store.data.data?.mapUrl ?? ''"></ui-btn>
							</template>
							<template x-if="$store.data.view !== 'detail'">
								<input-text
									data-type="url"
									placeholder="https://(또는 http://)를 포함하여 URL를 입력해주세요"
									:view="$store.data.view"
									:value="$store.data.data?.mapUrl ?? ''"></input-text>
							</template>
						</div>
					</li>
				</ul>
			</section>

			<section class="shadow-1xs rounded-lg bg-white p-5" id="target-scroll-tab-section-1">
				<ui-tit tag="h2" size="lg" tit="커스텀 항목"></ui-tit>

				<group-custom :view="$store.data.view" :result="JSON.stringify($store.data.data)"></group-custom>
			</section>
		</article>
	</div>
</LayoutBasic>

<script defer>
	document.addEventListener('alpine:init', () => {
		const listStore = Alpine.store('data');
		if (listStore) return;

		Alpine.store('data', {
			items: [],
			data: {},
			item: null,
			pageId: '',
			itemsToShow: 10,
			loading: false,
			error: null,
			itemId: '',
			getItemId() {
				return sessionStorage.getItem('cms-loc-page-view-id');
			},
			setItemId(id = '') {
				this.itemId = id;
				sessionStorage.setItem('cms-loc-page-view-id', id);
			},
			view: sessionStorage.getItem('cms-loc-page-view') ?? 'reg',
			setView(view) {
				this.view = view;
				sessionStorage.setItem('cms-loc-page-view', view);
			},
			async init() {
				this.loading = true;
				this.error = null;

				try {
					const res = await fetch('http://localhost:5185/tour-destinations');

					if (!res.ok) {
						throw new Error('Failed to load json');
					}

					const data = await res.json();

					this.items = data.data.items;

					if (this.view === 'detail' || this.view === 'edit') {
						await this.findInit(this.getItemId());
					}
				} catch (error) {
					this.error = error.message ?? 'Unknown error';
					console.error('초기 데이터 설정 실패:', error);
				} finally {
					this.loading = false;
				}
			},
			async findInit(id = '') {
				if (!id) return;

				this.data = this.items.find((v) => v.id === Number(id));

				console.log(this.data);
			},
		});
	});
</script>
