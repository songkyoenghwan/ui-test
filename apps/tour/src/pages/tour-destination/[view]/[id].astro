---
import DialogAddrSearch from '@/components/modals/DialogAddrSearch.astro';
import DialogSetCenterCoordinates from '@/components/modals/DialogSetCenterCoordinates.astro';
import LayoutBasic from '@/layouts/LayoutBasic.astro';
---

<LayoutBasic>
	<div class="sticky top-0 z-5 grid w-full min-w-5xl bg-slate-50 pb-5">
		<section class="w-full space-y-2 bg-slate-50 p-5 transition-all">
			<div class="flex items-center justify-between">
				<div>
					<template x-if="$store.data.view === 'reg'">
						<ui-tit tag="h2" size="lg" tit="대상지 등록"></ui-tit>
					</template>

					<template x-if="$store.data.view === 'edit'">
						<ui-tit tag="h2" size="lg" tit="대상지 수정"></ui-tit>
					</template>

					<template x-if="$store.data.view === 'detail'">
						<ui-tit tag="h2" size="lg" :tit="$store.data.data?.name?.ko ?? ''"></ui-tit>
					</template>
				</div>

				<div class="flex items-center gap-3">
					<template x-if="$store.data.view === 'detail'">
						<div class="flex gap-3">
							<ui-btn class="w-20" variant="ghost" size="lg" txt="목록"></ui-btn>

							<ui-btn class="w-20" variant="ghost" size="lg" txt="삭제"></ui-btn>

							<ui-btn
								tag="a"
								variant="primary"
								size="lg"
								class="w-20"
								txt="수정"
								x-bind:link="`/tour-destination/edit/${$store.data.itemId}`"></ui-btn>
						</div>
					</template>
				</div>

				<template x-if="$store.data.view === 'edit' || $store.data.view === 'reg'">
					<ui-btn class="w-20" variant="primary" size="lg" txt="저장" @btn-click="$store.data.saveData()"></ui-btn>
				</template>
			</div>
		</section>

		<div class="flex items-center">
			<ui-tit class="px-4.5" tit="섹션"></ui-tit>

			<div class="flex items-center gap-3">
				<ui-btn
					class="w-60 gap-3"
					tag="label"
					variant="segmented"
					size="lg"
					name="tab-section"
					:arr="JSON.stringify([{ name: '대상지 정보', txt: '대상지 정보' }, { name: '커스텀 항목', txt: '커스텀 항목' }])"
					scroll="tab-section"></ui-btn>
			</div>
		</div>
	</div>

	<article class="space-y-5 px-5 pb-5">
		<section class="shadow-1xs space-y-3 rounded-lg bg-white p-5 text-sm" id="target-scroll-tab-section-0">
			<ui-tit tag="h3" size="lg" tit="대상지 정보"></ui-tit>

			<ul
				class="divide-y divide-slate-300"
				x-data="{
						get supportedLanguages() {
							return JSON.stringify(
								$store.data.data?.supportedLanguages ?? {
									ko: true,
									en: true,
									ja: false,
									th: false,
									vi: false,
									zh: false,
								}
							)
						},
						// get firstName() {
						// 	return JSON.stringify($store.data.data?.name) ?? '{}'
						// },
						filterSupportedLang(value = {}) {
							if ($store.data.view !== 'detail') return value

							const supported = $store.data.data?.supportedLanguages ?? {}
							return ['ko', 'en', 'zh', 'ja', 'th', 'vi'].reduce((acc, key) => {
								if (supported[key]) {
									acc[key] = value?.[key] ?? ''
								}

								return acc
							}, {})
						},
						get nameLang() {
							return JSON.stringify(this.filterSupportedLang($store.data.data?.name ?? {}))
						},
						get tourDestinationOperatingSchedules() {
							return JSON.stringify($store.data.data?.tourDestinationOperatingSchedules) ?? '{}'
						},
						get operatingSchedules() {
							const schedules = $store.data.data?.tourDestinationOperatingSchedules ?? []
							if (!Array.isArray(schedules) || schedules.length === 0) return ''

							const { openingTime = '', closingTime = '' } = schedules[0] ?? {}
							const isSameTime = schedules.every((schedule) => {
								return schedule?.openingTime === openingTime && schedule?.closingTime === closingTime
							})

							return isSameTime && openingTime && closingTime ? `${openingTime} ~ ${closingTime}` : '요일별 상이'
						},
						get firstPoiNameKo() {
							return this.firstPoi?.poi?.name?.ko ?? ''
						},
						get poiMappingsLength() {
							return $store.data.data?.facilityPoiMappings?.length ?? 0
						},
						get operationGuide() {
							return JSON.stringify(this.filterSupportedLang($store.data.data?.operationInfo ?? {}))
						}
						
					}"
			>
				<li>
					<div class="grid max-w-375 grid-cols-[240px_1fr] gap-5 px-4 py-5 has-[[view=detail]]:grid-cols-[122px_1fr]">
						<ui-tit
							tit="제공 언어"
							:sub="$store.data.view !== 'detail' ? '사용자에게 제공할 언어를 선택해 주세요' : ''"></ui-tit>
						<lang-chk
							data-field="supportedLanguages"
							class="flex flex-wrap items-center gap-5"
							:class="$store.data.view !== 'detail' ? 'justify-end' : ''"
							:view="$store.data.view"
							:lang="supportedLanguages"></lang-chk>
					</div>
				</li>
				<li>
					<div class="grid max-w-375 grid-cols-[100px_1fr] gap-5 px-4 py-5 has-[[view=detail]]:grid-cols-[122px_1fr]">
						<ui-tit
							tit="대상지명"
							:tip="$store.data.view !== 'detail' ? '15자 이내 권장' : ''"
							:tooltip="$store.data.view !== 'detail' ? '언어에 따라 표현 길이가 달라질 수 <br />있으므로 번역 내용을 확인해주세요. (최대 50자)' : ''"
						></ui-tit>
						<lang-translate
							data-max-length="50"
							data-field="name"
							:view="$store.data.view"
							:lang="nameLang"
							@translate="$store.data.t($event.detail.lang)"
						>
						</lang-translate>
					</div>
				</li>

				<li>
					<div class="grid max-w-375 grid-cols-[100px_1fr] gap-5 px-4 py-5 has-[[view=detail]]:grid-cols-[122px_1fr]">
						<ui-tit tit="위치" cls="h-full items-center"></ui-tit>

						<template x-if="$store.data.view !== 'detail'">
							<div class="flex flex-wrap items-center gap-5">
								<ui-txt size="sm" txt="지도의 중심 좌표를 선택해 주세요"></ui-txt>
								<ui-btn
									class="min-w-30"
									variant="ghost"
									size="md"
									txt="지도에서 선택하기"
									x-bind="ModalHandler"
									data-target="DialogSetCenterCoordinates"
									@btn-click="$nextTick(() => { $store.map.openCenterPicker({ containerId: 'map_div' }) })"
								></ui-btn>
								<ui-txt size="sm" txt="서울특별시 용산구 이태원로 29 (한강로1가)" cls="text-black"></ui-txt>
							</div>
						</template>

						<template x-if="$store.data.view === 'detail'">
							<div class="flex flex-wrap items-center gap-5">
								<ui-txt size="sm" txt="서울특별시 용산구 이태원로 29 (한강로1가)" cls="text-black"></ui-txt>
							</div>
						</template>
					</div>
				</li>

				<li>
					<div class="grid max-w-375 grid-cols-2 gap-5 divide-x divide-slate-200 px-4 py-5">
						<div class="group grid grid-cols-[100px_1fr] gap-5 has-[[view=detail]]:grid-cols-[122px_1fr]">
							<ui-tit
								class="pt-1 group-has-[[view=detail]]:place-content-center group-has-[[view=detail]]:pt-0"
								tit="운영 기간"></ui-tit>
							<operating-period
								data-field="operatingPeriod"
								:view="$store.data.view"
								:is-always="$store.data.view !== 'reg' ? $store.data.data?.isAlways : true"
								:start-at="$store.data.data?.startAt"
								:end-at="$store.data.data?.endAt"></operating-period>
						</div>

						<div class="group grid grid-cols-[100px_1fr] gap-5 has-[[view=detail]]:grid-cols-[122px_1fr]">
							<ui-tit
								class="pt-1 group-has-[[view=detail]]:place-content-center group-has-[[view=detail]]:pt-0"
								tit="정기 휴무"></ui-tit>
							<closing-day
								data-field="holidaySchedules"
								:view="$store.data.view"
								:result="$store.data.view !== 'reg' ? JSON.stringify($store.data.data?.tourDestinationHolidaySchedules) : []"
							></closing-day>
						</div>
					</div>
				</li>

				<li class="relative z-3">
					<div
						class="group grid max-w-375 grid-cols-[100px_1fr] gap-5 px-4 py-5 has-[[view=detail]]:grid-cols-[122px_1fr]"
					>
						<ui-tit class="pt-1 group-has-[[view=detail]]:pt-0" tit="운영 시간"></ui-tit>

						<operating-hours
							data-field="operatingSchedules"
							rest="off"
							:view="$store.data.view"
							:result="tourDestinationOperatingSchedules"></operating-hours>
					</div>
				</li>

				<li>
					<div class="grid max-w-375 grid-cols-[100px_1fr] gap-5 px-4 py-5 has-[[view=detail]]:grid-cols-[122px_1fr]">
						<ui-tit
							tit="운영 안내"
							x-bind:req="$store.data.view !== 'detail'"
							x-bind:tip="$store.data.view !== 'detail' ? '30자 이내 권장' : ''"
							:tooltip="$store.data.view !== 'detail' ? '언어에 따라 표현 길이가 달라질 수 <br />있으므로 번역 내용을 확인해주세요. (최대 60자)' : ''"
						></ui-tit>

						<lang-translate
							data-field="operationInfo"
							data-max-length="60"
							:view="$store.data.view"
							:lang="operationGuide"></lang-translate>
					</div>
				</li>

				<li class="space-y-2">
					<div class="grid max-w-375 grid-cols-[200px_1fr] gap-5 px-4 pt-5 has-[[view=detail]]:grid-cols-[122px_1fr]">
						<ui-tit
							tit="홈페이지 링크"
							x-bind:req="$store.data.view !== 'detail'"
							:sub="$store.data.view !== 'detail'? '사용자에게 제공할 링크를 작성해 주세요' : ''"></ui-tit>

						<template x-if="$store.data.view === 'detail'">
							<ui-link
								icon-name="link"
								icon-pos="lt"
								icon-cls="size-3 stroke-black flex"
								:view="$store.data.view"
								:txt="$store.data.data?.homepageUrl ?? '미설정'"
								:link="$store.data.data?.homepageUrl ?? null"></ui-link>
						</template>
						<template x-if="$store.data.view !== 'detail'">
							<input-text
								data-field="homepageUrl"
								data-type="url"
								placeholder="https://(또는 http://)를 포함하여 URL를 입력해주세요"
								:view="$store.data.view"
								:value="$store.data.data?.homepageUrl ?? ''"></input-text>
						</template>
					</div>

					<div class="grid max-w-375 grid-cols-[200px_1fr] gap-5 px-4 has-[[view=detail]]:grid-cols-[122px_1fr]">
						<ui-tit tit="사용자 지도 링크" x-bind:req="$store.data.view !== 'detail'"></ui-tit>

						<template x-if="$store.data.view === 'detail'">
							<ui-link
								icon-name="link"
								icon-pos="lt"
								icon-cls="size-3 stroke-black flex"
								:view="$store.data.view"
								:txt="$store.data.data?.homepageUrl ?? '미설정'"
								:link="$store.data.data?.homepageUrl ?? null"></ui-link>
						</template>
						<template x-if="$store.data.view !== 'detail'">
							<input-text
								data-field="mapUrl"
								data-type="url"
								placeholder="https://(또는 http://)를 포함하여 URL를 입력해주세요"
								:view="$store.data.view"
								:value="$store.data.data?.mapUrl ?? ''"></input-text>
						</template>
					</div>
				</li>
			</ul>
		</section>

		<section class="shadow-1xs rounded-lg bg-white p-5" id="target-scroll-tab-section-1">
			<ui-tit tag="h2" size="lg" tit="커스텀 항목"></ui-tit>

			<group-custom data-field="customConfig" :view="$store.data.view" :result="JSON.stringify($store.data.data) ?? '{}'"
			></group-custom>
		</section>
	</article>
</LayoutBasic>

<DialogSetCenterCoordinates />
<DialogAddrSearch />

<script defer>
	document.addEventListener('alpine:init', () => {
		if (Alpine.store('data')) return;

		Alpine.store('data', {
			items: [],
			data: {},
			item: null,
			name: {},
			pageId: '',
			loading: false,
			error: null,
			itemId: '',
			view: 'detail',

			setItemId(id = '') {
				this.itemId = id;
			},

			getItemId() {
				return this.itemId;
			},

			getRouteInfo() {
				const segments = window.location.pathname.split('/').filter(Boolean);
				return {
					resource: segments[0] ?? '',
					view: segments[1] ?? 'reg',
					id: segments[2] ?? '',
				};
			},

			getCookie(name) {
				return (
					document.cookie
						.split('; ')
						.find((row) => row.startsWith(`${name}=`))
						?.split('=')[1] ?? ''
				);
			},

			getField(selector) {
				return document.querySelector(`[data-field="${selector}"]`);
			},

			parseValue(value, fallback) {
				if (typeof value !== 'string') return value ?? fallback;
				if (!value.trim()) return fallback;

				try {
					return JSON.parse(value);
				} catch {
					return value;
				}
			},

			getSupportedLangValue(value = {}) {
				if (this.view !== 'detail') return value ?? {};

				const supported = this.data?.supportedLanguages ?? {};
				return ['ko', 'en', 'zh', 'ja', 'th', 'vi'].reduce((acc, key) => {
					if (supported[key]) {
						acc[key] = value?.[key] ?? '';
					}

					return acc;
				}, {});
			},

			getLangValue(field, fallback = {}) {
				const el = this.getField(field);
				const value = this.parseValue(el?.lang, fallback);
				const inputValue = (key) => el?.querySelector(`input[id$="-${key}"]`)?.value ?? value?.[key] ?? '';

				return {
					ko: inputValue('ko'),
					en: inputValue('en'),
					zh: inputValue('zh'),
					ja: inputValue('ja'),
					th: inputValue('th'),
					vi: inputValue('vi'),
				};
			},

			toNullableNumber(value) {
				if (value === null || value === undefined || value === '') return null;
				const num = Number(value);
				return Number.isFinite(num) ? num : null;
			},

			getHolidaySchedules() {
				const el = this.getField('holidaySchedules');
				const fixedHolidaySelect = el?.querySelector('select[id$="-closing-date"]');

				if (fixedHolidaySelect) {
					const fixedHoliday = this.toNullableNumber(fixedHolidaySelect.value);
					return [
						{
							weekOfMonth: undefined,
							dayOfWeek: undefined,
							fixedHoliday: fixedHoliday ?? undefined,
							holidayType: 1,
						},
					];
				}

				const schedules = this.parseValue(el?.result, this.data.tourDestinationHolidaySchedules ?? []);
				return (Array.isArray(schedules) ? schedules : [])
					.map((schedule) => {
						const fixedHoliday = this.toNullableNumber(schedule.fixedHoliday);
						const weekOfMonth = this.toNullableNumber(schedule.weekOfMonth);
						const dayOfWeek = this.toNullableNumber(schedule.dayOfWeek);
						const holidayType = fixedHoliday != null ? 1 : this.toNullableNumber(schedule.holidayType);
						return {
							weekOfMonth: weekOfMonth ?? undefined,
							dayOfWeek: dayOfWeek ?? undefined,
							fixedHoliday: fixedHoliday ?? undefined,
							holidayType: holidayType ?? undefined,
						};
					})
					.filter(
						(schedule) => schedule.weekOfMonth != null || schedule.dayOfWeek != null || schedule.fixedHoliday != null,
					);
			},

			getOperatingSchedules() {
				const el = this.getField('operatingSchedules');
				const schedules = this.parseValue(el?.result, this.data.tourDestinationOperatingSchedules ?? []);
				const rows = Array.isArray(schedules) ? schedules : [];
				const selectedStatus = el?.querySelector('input[name$="-operating-hours"]:checked')?.value;
				const getTime = (schedule = {}) => ({
					openingTime: schedule?.openingTime ?? '00:00',
					closingTime: schedule?.closingTime ?? '01:00',
				});
				const isValidTime = (schedule) => schedule.openingTime && schedule.closingTime;
				const isDailySchedule =
					selectedStatus === 'always' ||
					(rows.length === 1 && rows[0]?.dayOfWeek == null && !Array.isArray(rows[0]?.dayOfWeeks));

				if (isDailySchedule) {
					const time = getTime(rows[0]);
					if (!isValidTime(time)) return [];

					return [0, 1, 2, 3, 4, 5, 6].map((dayOfWeek) => ({
						dayOfWeek,
						...time,
					}));
				}

				return rows
					.flatMap((schedule) => {
						const dayOfWeeks = Array.isArray(schedule?.dayOfWeeks) ? schedule.dayOfWeeks : [schedule?.dayOfWeek];
						const time = getTime(schedule);

						return dayOfWeeks.map((dayOfWeek) => ({
							dayOfWeek: this.toNullableNumber(dayOfWeek),
							...time,
						}));
					})
					.filter((schedule) => schedule.dayOfWeek != null && isValidTime(schedule));
			},

			buildPayload() {
				const name = this.getLangValue('name', this.data.name ?? {});
				const supportedLanguages = this.parseValue(
					this.getField('supportedLanguages')?.lang,
					this.data.supportedLanguages ?? {},
				);
				const operationInfo = this.getLangValue('operationInfo', this.data.operationInfo ?? {});
				const operatingPeriod = this.getField('operatingPeriod');
				const operatingSchedules = this.getOperatingSchedules();
				const holidaySchedules = this.getHolidaySchedules();
				const customConfig = this.parseValue(this.getField('customConfig')?.result, this.data ?? {});
				const isAlways = Boolean(operatingPeriod?.isAlways ?? this.data.isAlways ?? true);
				const latitude = Number.isFinite(Number(this.data.latitude)) ? Number(this.data.latitude) : 39.2331;
				const longitude = Number.isFinite(Number(this.data.longitude)) ? Number(this.data.longitude) : 127.393;

				if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) {
					throw new Error('대상지 위치 좌표를 확인해 주세요.');
				}

				return {
					name,
					supportedLanguages,
					latitude,
					longitude,
					startAt: isAlways ? undefined : (operatingPeriod?.startAt ?? this.data.startAt ?? undefined),
					endAt: isAlways ? undefined : (operatingPeriod?.endAt ?? this.data.endAt ?? undefined),
					colorCode: customConfig?.colorCode ?? this.data.colorCode ?? '#16B17D',
					homepageUrl: this.getField('homepageUrl')?.value ?? this.data.homepageUrl ?? '',
					mapUrl: this.getField('mapUrl')?.value ?? this.data.mapUrl ?? '',
					isAlways,
					isAiRecommendYn: Boolean(customConfig?.isAiRecommendYn ?? this.data.isAiRecommendYn),
					isFacilityCongestionYn: Boolean(customConfig?.isFacilityCongestionYn ?? this.data.isFacilityCongestionYn),
					isSectionCongestionYn: Boolean(customConfig?.isSectionCongestionYn ?? this.data.isSectionCongestionYn),
					isFacilityAddressYn: Boolean(customConfig?.isFacilityAddressYn ?? this.data.isFacilityAddressYn),
					isCustomSortingYn: Boolean(customConfig?.isCustomSortingYn ?? this.data.isCustomSortingYn),
					operationInfo,
					tourDestinationCommonButtons: (customConfig?.tourDestinationCommonButtons ?? []).map((button, index) => ({
						iconUrl: button.iconUrl ?? '',
						buttonName: button.buttonName ?? {},
						sortingNumber: button.sortingNumber ?? index,
					})),
					tourDestinationOperatingSchedules: operatingSchedules,
					tourDestinationHolidaySchedules: holidaySchedules,
				};
			},

			async saveData() {
				this.loading = true;
				this.error = null;

				try {
					const { view, id } = this.getRouteInfo();
					const isEdit = view === 'edit';
					const payload = this.buildPayload();
					const url = isEdit ? `/api/tour-destinations/${id}` : '/api/tour-destinations';
					console.log('[tour-destination:save] request', {
						method: isEdit ? 'PATCH' : 'POST',
						url,
						payload,
					});
					const res = await fetch(url, {
						method: isEdit ? 'PATCH' : 'POST',
						headers: {
							'Content-Type': 'application/json',
							'X-CSRF-Token': decodeURIComponent(this.getCookie('csrfToken')),
						},
						credentials: 'include',
						body: JSON.stringify(payload),
					});

					if (!res.ok) {
						const text = await res.text();
						let errorBody = text;
						try {
							errorBody = JSON.parse(text);
						} catch {}

						console.error('[tour-destination:save] response error', {
							status: res.status,
							statusText: res.statusText,
							body: errorBody,
							payload,
						});
						throw new Error(`Failed to save tour destination: ${res.status}`);
					}

					const data = await res.json();
					const saved = data.data ?? {};
					window.location.href = `/tour-destination/detail/${saved.id ?? id}`;
				} catch (error) {
					this.error = error instanceof Error ? error.message : 'Unknown error';
					console.error('데이터 저장 실패:', error);
					alert('저장에 실패했습니다.');
				} finally {
					this.loading = false;
				}
			},

			async fetchData() {
				this.loading = true;
				this.error = null;

				try {
					const { view, id } = this.getRouteInfo();
					this.view = view;
					this.setItemId(id);

					if (!id || view === 'reg') return;

					const res = await fetch(`/api/tour-destinations`);
					if (!res.ok) throw new Error('Failed to load json');

					const data = await res.json();
					const payload = data.data ?? {};
					this.data = payload;
					this.name = JSON.stringify(this.data.name) ?? '{}';

					const nameEl = this.getField('name');
					if (nameEl) {
						nameEl.lang = this.getSupportedLangValue(this.data.name);
					}

					const operationInfoEl = this.getField('operationInfo');
					if (operationInfoEl) {
						operationInfoEl.lang = this.getSupportedLangValue(this.data.operationInfo);
					}
					this.items = payload.items?.[0];
				} catch (error) {
					this.error = error instanceof Error ? error.message : 'Unknown error';
					console.error('데이터 로드 실패:', error);
				} finally {
					this.loading = false;
				}
			},

			async init() {
				await this.fetchData();

				await this.findInit(1);
			},

			async findInit(id = '') {
				if (!id) return;
				this.data = this.items.find((v) => v.id === Number(id)) ?? {};

				this.name = JSON.stringify(this.data.name) ?? '{}';

				document.querySelector('lang-translate').lang = this.getSupportedLangValue(this.data.name);
			},

			t(lang) {
				this.data.name = {
					ko: '',
					en: '',
					zh: '',
					ja: '',
					th: '',
					vi: '',
				};

				const el = this.getField('name');
				if (el) {
					el.lang = this.data.name;
				}
			},
		});
	});
</script>
