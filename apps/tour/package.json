{
	"name": "tour",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"astro": "astro dev --host --port 5194",
		"build": "bun run fm && astro build -c vite.config.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"doctor": "svelte-doctor check",
		"dev": "bun run --parallel astro",
		"mock": "json-server --watch ./src/mocks/db.json --routes ./src/mocks/routes.json --host 0.0.0.0 --port 3001",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"fm": "prettier --write . && oxfmt",
		"format:prettier": "prettier --write .",
		"lang": "bun x @inlang/cli machine translate --project ./project.inlang",
		"lang:val": "bun x @inlang/cli validate --project ./project.inlang",
		"lint": "oxlint .",
		"pb": "./pocketbase serve",
		"prepare": "svelte-kit sync || echo ''",
		"preview:astro": "astro preview",
		"preview": "bun run preview:astro --host --port 5196",
		"sp:fix": "syncpack fix",
		"sp:format": "syncpack format",
		"sp:lint": "syncpack lint --dependency-types prod,dev",
		"wc": "bun -b run vite build -c vite.config.sv.mjs",
		"node:kill": "taskkill /f /im node.exe"
	},
	"dependencies": {
		"@alpinejs/sort": "^3.15.12",
		"@ariefsn/svelte-use": "^1.1.0",
		"@astrojs/alpinejs": "^1.0.0",
		"@astrojs/node": "^11.0.2",
		"@astrojs/svelte": "^9.0.1",
		"@astrojs/ts-plugin": "^1.10.10",
		"@dnd-kit/helpers": "^0.5.0",
		"@dnd-kit/svelte": "^0.5.0",
		"@master/css": "^1.37.8",
		"@uinstinct/svelte-wheel-picker": "^0.1.33",
		"alpinejs": "^3.15.12",
		"astro": "^7.1.3",
		"dayjs": "^1.11.21",
		"embla-carousel": "^8.6.0",
		"embla-carousel-svelte": "^8.6.0",
		"es-toolkit": "^1.50.0",
		"flowbite": "^4.0.2",
		"keen-slider": "^6.8.6",
		"lit": "^3.3.3",
		"nanostores": "^1.4.1",
		"pickerjs": "^1.2.1",
		"sortablejs": "^1.15.7",
		"svelte-awesome-color-picker": "^4.1.3",
		"svelte-draggable-plus": "^0.1.1",
		"svelty-picker": "^6.1.6",
		"swiper": "^14.0.6",
		"toastify-js": "^1.12.0",
		"unsortable": "^0.1.9",
		"uuid": "^14.0.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@floating-ui/utils": "^0.2.12",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@imask/svelte": "^7.6.1",
		"@inlang/paraglide-js": "^2.22.0",
		"@lucide/svelte": "^1.26.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/enhanced-img": "^0.10.4",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@tsconfig/svelte": "^5.0.8",
		"@types/alpinejs": "^3.13.11",
		"@types/bun": "^1.3.14",
		"@types/dropzone": "^5.7.9",
		"@types/node": "^25.9.5",
		"@types/sortablejs": "^1.15.9",
		"concurrently": "^9.2.4",
		"css-property-sort-order-smacss": "^3.0.0",
		"flatpickr": "^4.6.13",
		"flowbite-svelte": "^1.33.1",
		"flowbite-svelte-icons": "^3.1.0",
		"imask": "^7.6.1",
		"json-server": "0.17.4",
		"oxc": "^1.0.1",
		"oxfmt": "^0.48.0",
		"oxlint": "^1.75.0",
		"postgres": "^3.4.9",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-css-order": "^2.2.0",
		"prettier-plugin-django-alpine": "^1.3.0",
		"prettier-plugin-organize-attributes": "^1.0.0",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sass": "^1.102.0",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.1.5"
	},
	"engines": {
		"node": ">=22.12.0"
	}
}
