{
	"name": "map-front",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"astro": "bun x astro dev stop && astro dev --host --port 5294",
		"build": "paraglide-js compile --project ./project.inlang --outdir ./src\\paraglide && bun run fm && astro build -c vite.config.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"doctor": "svelte-doctor check",
		"dev": "bun run --parallel astro",
		"mock": "json-server --watch ./src/mocks/db.json --host 0.0.0.0 --port 3001",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"fm": "prettier --write . && oxfmt",
		"format:prettier": "prettier --write .",
		"lang": "bun x @inlang/cli machine translate --project ./project.inlang",
		"lang:val": "bun x @inlang/cli validate --project ./project.inlang",
		"lint": "oxlint .",
		"pb": "./pocketbase serve",
		"prepare": "svelte-kit sync || echo ''",
		"preview:astro": "astro preview",
		"preview": "bun run preview:astro --host --port 5296",
		"sp:fix": "syncpack fix",
		"sp:format": "syncpack format",
		"sp:lint": "syncpack lint --dependency-types prod,dev",
		"wc": "bun -b run vite build -c vite.config.sv.mjs",
		"node:kill": "taskkill /f /im node.exe",
		"machine-translate": "inlang machine translate --project project.inlang"
	},
	"dependencies": {
		"@alpinejs/mask": "^3.15.12",
		"@alpinejs/persist": "^3.15.12",
		"@alpinejs/sort": "^3.15.12",
		"@astrojs/alpinejs": "^1.0.0",
		"@astrojs/node": "11.1.1",
		"@astrojs/react": "^6.0.2",
		"@astrojs/svelte": "^9.0.1",
		"@nanostores/alpine": "^0.1.1",
		"@nanostores/lit": "^0.2.3",
		"@nanostores/persistent": "^1.3.5",
		"@nanostores/svelte-runes": "^1.0.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/svelte-table": "^9.1.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"astro": "7.2.1",
		"dayjs": "^1.11.23",
		"lit": "^3.3.3",
		"maplibre-gl": "^6.4.1",
		"nanostores": "^1.4.2",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"svelte": "^5.56.8",
		"svelte-bottom-sheet": "^2.3.1",
		"svelte-intersection-observer": "^2.2.0",
		"swiper": "^14.0.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"uuid": "^14.0.1"
	},
	"devDependencies": {
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@inlang/cli": "^3.3.0",
		"@inlang/paraglide-js": "^2.23.1",
		"@inlang/paraglide-js-svelte": "^1.0.4",
		"@prettier/plugin-oxc": "^0.2.2",
		"flowbite": "^4.0.2",
		"flowbite-svelte": "^1.33.1",
		"oxfmt": "^0.64.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-css-order": "^2.2.0",
		"prettier-plugin-organize-attributes": "^1.0.0",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"zod": "^4.4.3"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"volta": {
		"node": "22.23.2"
	}
}
