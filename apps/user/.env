# -----------------------------------------------
# 개발 환경 (.env.develop)
# 이 파일을 복사해서 .env 로 사용하세요.
# cp .env.develop .env
# -----------------------------------------------

# 현재 환경 (develop | production)
NODE_ENV=development
# PostgreSQL 연결 문자열
DATABASE_URL="postgresql://app_service:Db2024!Srv%23Connection%40Secure9@192.168.1.120:5434/tourism_solution"
# 서버 포트
PORT=3011
# Google Cloud Translation Basic v2 API Key
# 실제 값은 .env.local의 GOOGLE_TRANSLATE_API_KEY에만 입력하세요.
GOOGLE_CLOUD_PROJECT=pj-visit-servant-dev
GOOGLE_TRANSLATE_API_KEY=AIzaSyAcBGTVCqeiK5o-zYaz5RAf69u8rQK23HI
# Google Maps API 키 — 역지오코딩 등 Maps API 호출 시 사용
GOOGLE_MAPS_API_KEY=AIzaSyCLB5uIxmMmC8_nAHD9syzJmRqEvVyDiW8
# 이미지 업로드
UPLOAD_LOCAL_DIR=./src/uploads
UPLOAD_PUBLIC_PATH=/uploads
# 운영 이미지 업로드(S3) — production 환경에서 사용
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=your-s3-bucket
AWS_S3_PUBLIC_BASE_URL=https://your-cdn-or-bucket-domain.example.com
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# JWT 인증
JWT_ACCESS_SECRET=your-jwt-access-secret
JWT_ACCESS_EXPIRES_IN=1500m
JWT_REFRESH_SECRET=your-jwt-refresh-secret
JWT_REFRESH_EXPIRES_IN=14d
JWT_ACCESS_COOKIE_NAME=accessToken
JWT_REFRESH_COOKIE_NAME=refreshToken
JWT_COOKIE_SAME_SITE=lax
JWT_COOKIE_SECURE=false
# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://192.168.1.120:3001,http://localhost:5194,http://192.168.1.120:5195,http://localhost:5196
CSRF_COOKIE_NAME=csrfToken
CSRF_HEADER_NAME=X-CSRF-Token
# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5000
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REFRESH_RATE_LIMIT_WINDOW_MS=60000
AUTH_REFRESH_RATE_LIMIT_MAX=120
UPLOAD_RATE_LIMIT_WINDOW_MS=600000
UPLOAD_RATE_LIMIT_MAX=20
# API URL (API 호출 시 사용)
API_BASE=http://localhost:3011
# TMAP API
TMAP_APP_KEY=a62eRxdhwgaVP9hXyreTL32mVuSVLU2iawIaEaOt
# UI API proxy/BFF
UI_API_LEGACY_TARGET=http://192.168.1.120:3001
UI_API_V1_TARGET=http://localhost:3011
