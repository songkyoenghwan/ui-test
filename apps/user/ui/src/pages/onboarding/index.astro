---
import Layout from '@/layouts/Layout.astro';
import Language from '@/svelte/btn/Language.svelte';
import OnboardingList from '@/svelte/onboarding/OnboardingList.svelte';
---

<Layout>
	<section class="h-dvh bg-(--base-color) bg-[url(/images/onboarding/bg-onboarding.png)] bg-cover bg-center bg-no-repeat">
		<div class="bg-linear-0 from-black/0 to-black/60 p-5">
			<Language client:only="svelte" />

			<OnboardingList client:only="svelte" />
		</div>
	</section>
</Layout>
