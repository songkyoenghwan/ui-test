---
import '@/svelte/pois/PoiPin.svelte';
---

<div class="relative h-dvh w-dvw overflow-clip">
	<section id="MapCanvas" class="grid h-dvh w-dvw"></section>
</div>

<script>
	import '@/svelte/pois/PoiPin.svelte';
	import MapController from '@/events/mapEvent';
	import { sheetMidRatioValue } from '@/src/stores/sheetUiStore';
	import { getDistance } from '@/stores/globalStore';
	import {
		current,
		currentDetail,
		facilityList,
		loadDestination,
		mapControllerInstance,
		poiList,
		recommendList,
		searchList,
	} from '@/stores/pageDataStore';
	import { sheetInstance, updateViewState } from '@/stores/uxStore';

	const DEFAULT_DESTINATION_ID = 1;

	function waitForTmap(timeout = 10000) {
		return new Promise((resolve, reject) => {
			if (window.Tmapv3) {
				resolve(window.Tmapv3);
				return;
			}

			const started = Date.now();
			const timer = setInterval(() => {
				if (window.Tmapv3) {
					clearInterval(timer);
					resolve(window.Tmapv3);
					return;
				}

				if (Date.now() - started > timeout) {
					clearInterval(timer);
					reject(new Error('Tmapv3 load timeout'));
				}
			}, 50);
		});
	}

	async function initMapPage() {
		const container = document.getElementById('MapCanvas');
		if (!container) return;

		await waitForTmap();

		const mapController = new MapController();
		mapController.containerId = 'MapCanvas';
		mapController.init();
		mapControllerInstance.set(mapController);

		mapController.map.on('ConfigLoad', async function () {
			const center = mapController.getCenterCoordinates();

			if (center) {
				getDistance.set({ lat: String(center.lat), lng: String(center.lng) });
			}

			mapController.groundOverlayInit('/images/overlay/img-overlay-bg.png');

			const detail = await loadDestination(DEFAULT_DESTINATION_ID);

			if (detail && Number.isFinite(detail.latitude) && Number.isFinite(detail.longitude)) {
				mapController.setCenter(detail.latitude, detail.longitude);
			}

			updateViewState({
				layout: 'default',
				detail: detail?.isAiRecommendYn ? 'ai' : 'default',
				search: 'default',
			});

			searchList.set(facilityList.get() ?? []);
			recommendList.set(facilityList.get() ?? []);

			const pois = new Map();
			const poiFacilityList = poiList.get().flatMap((poi) =>
				(poi.facilityPoiMappings ?? []).map((mapping) => ({
					poiId: poi.id,
					poiName: poi.name,
					latitude: poi.latitude,
					longitude: poi.longitude,
					facilityId: mapping.facilityId,
					category: mapping.facility?.category,
					congestionStatus: mapping.congestionStatus ?? 'none',
				})),
			);

			poiFacilityList.forEach((item) => {
				const label =
					item.poiName && typeof item.poiName === 'object' && 'ko' in item.poiName
						? String(item.poiName.ko ?? '')
						: '';

				const newPoi = mapController.makerPin(
					item.latitude,
					item.longitude,
					item.category?.iconKey ?? 'location',
					item.congestionStatus,
					item.category?.categoryColorCodes?.colorCode ?? 'var(--base-color)',
					label,
					'category',
					String(item.facilityId ?? ''),
				);

				pois.set(item.facilityId, newPoi);

				const marker = pois.get(item.facilityId);

				marker?.on('Click', async () => {
					const clickedFacilityId = Number(item.facilityId);
					current.setKey('facility', clickedFacilityId);
					current.setKey('poi', item.poiId);

					updateViewState({
						layout: 'facilities',
						detail: 'facilities',
						search: 'idle',
					});

					mapController.setCenter(item.latitude - 0.0005, item.longitude);
					sheetInstance.get()?.setSnapPoint(sheetMidRatioValue.get());
					currentDetail();
				});
			});
		});
	}

	initMapPage().catch((error) => {
		console.error('[MapCanvas] init failed:', error);
	});
</script>
