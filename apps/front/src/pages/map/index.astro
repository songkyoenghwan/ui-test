---
import Layout from '@/layouts/Layout.astro';
import BackView from '@/src/components/svelte/map/BackView.svelte';
import Category from '@/src/components/svelte/map/Category.svelte';
import SearchBar from '@/src/components/svelte/map/SearchBar.svelte';
import Sheet from '@/src/components/svelte/map/Sheet.svelte';
import Map from '@/src/pages/map/MapCanvas.astro';
---

<Layout>
	<Map />

	<SearchBar client:only="svelte" name="대상지명" />
	<Category client:only="svelte" />

	<BackView client:only="svelte" />

	<Sheet client:only="svelte" />

	<button type="button" class="fixed top-1/5 left-0" data-btn="poi">poi</button>
	<button type="button" class="fixed top-1/5 left-10" data-btn="ai">ai</button>
</Layout>

<script>
	import { updateViewState } from '@/stores/uxStore';

	updateViewState({
		layout: 'ai',
		detail: 'ai',
		search: 'idle',
	});

	document.querySelector('[data-btn="poi"]')?.addEventListener('click', () => {
		updateViewState({
			layout: 'facilities',
			detail: 'facilities',
			search: 'idle',
		});
	});

	document.querySelector('[data-btn="ai"]')?.addEventListener('click', () => {
		updateViewState({
			layout: 'ai',
			detail: 'ai',
			search: 'idle',
		});
	});
</script>
