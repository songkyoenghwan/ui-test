---
import Layout from '@/layouts/Layout.astro';
import BackView from '@/src/components/svelte/map/BackView.svelte';
import Category from '@/src/components/svelte/map/Category.svelte';
import SearchBar from '@/src/components/svelte/map/SearchBar.svelte';
import Sheet from '@/src/components/svelte/map/Sheet.svelte';
import { categories } from './dummy';
---

<Layout>
	<SearchBar client:only="svelte" name="대상지명" />
	<Category client:only="svelte" categories={categories} />

	<BackView client:only="svelte" />

	<Sheet client:only="svelte" />

	<!-- <button type="button" class="fixed bottom-1/2 left-0" data-btn="detail">detail</button> -->
</Layout>

