---
import Icons from '@/svelte/icons/Icons.svelte';
import Confusion from '@/svelte/map/Confusion.svelte';
---

<div
	x-data
	class="fixed right-5 bottom-0 z-40 transition-[bottom] duration-10 ease-in"
	:style="{ bottom: $store.ux.sheetSnapPoint + '%' }"
>
	<div
		x-show="$store.ux.sheetSnapPoint <= 70"
		class="relative flex flex-col gap-2 opacity-100 transition-all *:grid *:size-10 *:place-content-center *:rounded-full *:bg-white *:shadow-2xs starting:opacity-0"
	>
		<button type="button" class="active:bg-(--base-color)/10">
			<Icons client:only="svelte" name="refresh" cls="size-5.5 fill-(--base-color) stroke-(--base-color)" />
		</button>
		<button type="button" class="active:bg-(--base-color)/10">
			<Icons client:only="svelte" name="gps" cls="size-5.5 fill-(--base-color) stroke-(--base-color)" />
		</button>
		<Confusion client:only="svelte" />
	</div>
</div>
