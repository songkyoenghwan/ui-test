---
import Logo from '@/components/img/Logo.astro';
import Layout from '@/layouts/Layout.astro';
import * as m from '@/paraglide/messages.js';
import Language from '@/svelte/btn/Language.svelte';
import type { GateItem } from '@/svelte/gate/Gate.event.svelte';
import Gate from '@/svelte/gate/Gate.svelte';

const OBD_LABELS = {
	1: m.usr_obd_001_03,
	2: m.usr_obd_001_04,
	3: m.usr_obd_001_05,
	4: m.usr_obd_001_06,
	5: m.usr_obd_001_07,
	6: m.usr_obd_001_08,
} as const;

type ObdCode = keyof typeof OBD_LABELS;

export function getObdLabel(code: ObdCode) {
	return OBD_LABELS[code]();
}

const gateList: GateItem[] = [
	{
		name: 'usr_obd_001_03',
		img: 'https://cdn.pixabay.com/photo/2026/06/30/07/54/whitetopaz-digital-art-10356325_1280.jpg',
		href: '/onboarding',
		code: 1,
	},
	{
		name: 'usr_obd_001_04',
		img: 'https://cdn.pixabay.com/photo/2026/06/30/07/54/whitetopaz-digital-art-10356325_1280.jpg',
		href: '/onboarding',
		code: 2,
	},
	{
		name: 'usr_obd_001_04',
		img: 'https://cdn.pixabay.com/photo/2026/06/30/07/54/whitetopaz-digital-art-10356325_1280.jpg',
		href: '/onboarding',
		code: 1,
	},
	{
		name: 'usr_obd_001_05',
		img: 'https://cdn.pixabay.com/photo/2026/06/30/07/54/whitetopaz-digital-art-10356325_1280.jpg',
		href: '/onboarding',
		code: 2,
	},
	{
		name: 'usr_obd_001_06',
		img: 'https://cdn.pixabay.com/photo/2026/06/30/07/54/whitetopaz-digital-art-10356325_1280.jpg',
		href: '/onboarding',
		code: 1,
	},
	{
		name: 'usr_obd_001_07',
		img: 'https://cdn.pixabay.com/photo/2026/06/30/07/54/whitetopaz-digital-art-10356325_1280.jpg',
		href: '/onboarding',
		code: 2,
	},
];
---

<Layout>
	<section class="flex h-dvh flex-col gap-3.5 overflow-x-clip overflow-y-auto p-5 **:tracking-tight">
		<Language client:only="svelte">
			<div class="flex justify-end" slot="fallback">
				<div class="flex h-9 w-27.5 animate-pulse justify-end rounded-lg bg-slate-100"></div>
			</div>
		</Language>

		<Logo />

		<Gate client:only="svelte" data={gateList}>
			<div class="flex flex-1 flex-col gap-2" slot="fallback">
				<div class="min-h-15 bg-white px-5 py-5">
					<div class="h-7 w-full animate-pulse rounded bg-slate-100"></div>
					<div class="mt-2 h-4 w-full animate-pulse rounded bg-slate-100"></div>
				</div>
				<div class="min-h-20 animate-pulse rounded bg-slate-100"></div>
			</div>
		</Gate>
	</section>
</Layout>
