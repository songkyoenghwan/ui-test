{
	"name": "my-monorepo",
	"private": true,
	"homepage": "songkyoenghwan.github.io/ui-test/",
	"workspaces": [
		"apps/homepage",
		"apps/tour",
		"front"
	],
	"scripts": {
		"build": "bun run --filter \"*\" build",
		"dev": "bun run --filter \"*\" dev",
		"wc": "bun run fm && bun run --filter \"*\" wc",
		"dev:homepage": " bun run --filter homepage dev",
		"dev:map": "bun run --filter map dev",
		"dev:tour": "bun run --filter tour dev",
		"dev:front": "bun run --filter front dev",
		"fm": "prettier --write . && oxfmt",
		"format:pretter": "prettier --write .",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check",
		"lang": "bun x @inlang/cli machine translate --project ./project.inlang",
		"lang:val": "bun x @inlang/cli validate --project ./project.inlang",
		"lint": "oxlint . --ignore-pattern \"**/output/**/*\"",
		"lint:fix": "oxlint --fix",
		"install:all": "bun install",
		"sp:fix": "syncpack fix",
		"sp:format": "syncpack format",
		"sp:lint": "syncpack lint --dependency-types prod,dev",
		"doctor": "svelte-doctor check",
		"node:kill": "taskkill /f /im node.exe"
	},
	"dependencies": {
		"@astrojs/alpinejs": "^1.0.0",
		"@astrojs/node": "^11.0.2",
		"@astrojs/svelte": "^9.0.1",
		"astro": "^7.1.3",
		"gh-pages": "^6.3.0",
		"lit": "^3.3.3",
		"svelte": "^5.56.8",
		"swiper": "^12.2.0"
	},
	"devDependencies": {
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@prettier/plugin-oxc": "^0.1.4",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.9.5",
		"concurrently": "^8.2.2",
		"oxc": "^1.0.1",
		"oxfmt": "^0.48.0",
		"oxlint": "^1.75.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-css-order": "^2.2.0",
		"prettier-plugin-organize-attributes": "^1.0.0",
		"prettier-plugin-sort-json": "^4.2.0",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"typescript": "~6.0.3",
		"vite": "^8.1.5"
	}
}
