---
import Language from '@/components/btn/Language.svelte';
import Logo from '@/components/img/Logo.astro';
---

<section class="p-5">
	<Language client:only />

	<header class="mt-3.5 flex flex-col items-center justify-center gap-1">
		<Logo />
		<h2 class="pt-1 text-[26px] font-bold">방문한 시장을 선택해 주세요</h2>
		<p class="text-lg text-slate-500">골목 구석구석 맞춤 정보를 안내해 드려요.</p>
	</header>

	<ul class="flex flex-wrap gap-3">
		<li class="flex-1 basis-1/4">
			<a
				href="http://"
				target="_blank"
				rel="noopener noreferrer"
				class="group/link flex flex-col justify-between rounded-lg border border-slate-300 bg-[#5d8fff]/5 p-1.5 active:border-slate-100"
			>
				<h3 class="text-base text-black">경동시장</h3>
				<picture class="min-h-20">
					<img src="" alt="" />
				</picture>

				<div
					class="flex justify-between rounded-sm border border-slate-100 from-[#274fa8] to-[#0f1f42] px-2 py-1 group-hover/link:bg-linear-90 group-hover/link:text-white group-active/link:bg-linear-90 group-active/link:text-white"
				>
					<p class="text-[10px] font-medium">진입하기</p>
				</div>
			</a>
		</li>
	</ul>
</section>
