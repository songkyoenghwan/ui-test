{
	"name": "ouster",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"module": "index.ts",
	"scripts": {
		"dev": "concurrently \"bun run tailwind:watch\" \"bun run client:dev\"",
		"build": "vite build",
		"preview": "vite preview",
		"client:dev": "vite dev --host",
		"tailwind:watch": "bun x @tailwindcss/cli -i ./src/lib/css/salesforce.css -o ./src/lib/css/salesforce-output.css --watch"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tailwindcss/cli": "^4.3.3",
		"@types/bun": "latest",
		"concurrently": "^9.2.4",
		"eslint": "^9.39.5",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"tailwindcss": "^4.3.3",
		"vite": "^6.4.3"
	},
	"peerDependencies": {
		"typescript": "^5.8.2"
	}
}
